{
  /*
    ============================================================
    LOGGING CONFIGURATION
    ============================================================
    Controls how application logs are written.
    - Default: Information level logs
    - Microsoft.AspNetCore: Warning level to reduce noise from framework logs
  */
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  /*
    ============================================================
    DATABASE CONNECTION STRING
    ============================================================
    MySQL connection string for the AADYA database.
    - Server: Database server (localhost for development)
    - Database: Database name (AADYA_DB)
    - User/Password: Database credentials
  */
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AADYA_DB;User=root;Password=root123;"
  },

  /*
    ============================================================
    JWT AUTHENTICATION SETTINGS
    ============================================================
    - Key: 32+ character secure key used to sign JWT tokens (MUST be changed in production)
    - Issuer: Identifies who issued the token (AADYA_API)
    - Audience: Identifies who the token is intended for (AADYA_Client)
    WARNING: In production, use Environment Variables or User Secrets.
  */
  "Jwt": {
    "Key": "CHANGE_ME_IN_ENVIRONMENT",
    "Issuer": "AADYA_API",
    "Audience": "AADYA_Client"
  },

  /*
    ============================================================
    SMTP EMAIL CONFIGURATION
    ============================================================
    Used for sending emails (OTP, order confirmations, etc.).
    - Host: SMTP server (smtp.gmail.com for Gmail)
    - Port: 587 (TLS) or 465 (SSL)
    - Username/Password: Email account credentials (use App Password for Gmail)
    - FromEmail: The sender email address displayed to recipients
    WARNING: In production, store credentials in Environment Variables or User Secrets.
  */
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "CHANGE_ME_IN_ENVIRONMENT",
    "Password": "CHANGE_ME_IN_ENVIRONMENT",
    "FromEmail": "CHANGE_ME_IN_ENVIRONMENT"
  },

  /*
    ============================================================
    CORS CONFIGURATION
    ============================================================
    Defines which origins are allowed to access the API.
    Add your production domain here when deploying.
  */
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "https://localhost:5001"
    ]
  },

  /*
    ============================================================
    HOST ALLOW LIST
    ============================================================
    Specifies which host headers the app will respond to.
    "*" allows all hosts (acceptable for development).
    For production, restrict to your domain(s).
  */
  "AllowedHosts": "*"
}