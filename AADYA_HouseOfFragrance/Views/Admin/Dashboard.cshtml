@{
    ViewData["Title"] = "Admin Operations Dashboard - House of AADYA";
}

<section class="section-padding" style="padding-top: 2rem;">
    <!-- ADMIN HEADER -->
    <div class="admin-header">
        <div>
            <span class="admin-tagline">OBJECTIVE (D): ADMIN BUSINESS ANALYTICS & OPERATIONS</span>
            <h1 class="admin-title">Real-Time Management Dashboard</h1>
        </div>
        <button class="btn-gold" onclick="openAddProductDrawer()">+ ADD NEW FRAGRANCE</button>
    </div>

    <!-- STATS CARDS - DYNAMIC -->
    <div class="admin-stats-grid" id="adminStatsGrid">
        <div class="stat-card"><span class="stat-label">Total Sales Revenue</span><div class="stat-value" id="statRevenue">₹0</div><span class="stat-sub text-green">Loading...</span></div>
        <div class="stat-card"><span class="stat-label">Catalog Products</span><div class="stat-value" id="statProducts">0</div><span class="stat-sub">100% Alcohol-Free</span></div>
        <div class="stat-card"><span class="stat-label">Total Orders</span><div class="stat-value" id="statOrders">0</div><span class="stat-sub">Live Transaction Logs</span></div>
        <div class="stat-card"><span class="stat-label">Registered Clients</span><div class="stat-value" id="statClients">0</div><span class="stat-sub">Secure User Database</span></div>
    </div>

    <!-- ORDER MANAGEMENT SECTION -->
    <div class="admin-table-card">
        <div class="admin-table-header-row">
            <h3 class="table-card-title">Order Management & Fulfillment Logs</h3>
            <div class="admin-filter-pills" id="orderFilterPills">
                <button class="filter-btn active" data-status="all">All Orders</button>
                <button class="filter-btn" data-status="Processing">Processing</button>
                <button class="filter-btn" data-status="Dispatched">Dispatched</button>
                <button class="filter-btn" data-status="Delivered">Delivered</button>
                <button class="filter-btn" data-status="Cancelled">Cancelled</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr><th>Order ID</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th style="text-align: right;">Actions</th></tr>
                </thead>
                <tbody id="adminOrdersTbody">
                    <!-- Rows injected by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- ADD PRODUCT SLIDING DRAWER -->
<div class="drawer-overlay" id="addProductOverlay" onclick="closeAddProductDrawer()"></div>
<div class="product-drawer" id="addProductDrawer">
    <button class="drawer-close-btn" onclick="closeAddProductDrawer()">&times;</button>
    <div class="drawer-content">
        <span class="drawer-tagline">OBJECTIVE (C): CATALOGING</span>
        <h2 class="drawer-title">Add New Fragrance</h2>
        <form id="addProductForm" onsubmit="handleCreateProduct(event)" class="auth-form">
            <div class="form-group"><label for="prodName">Fragrance Title</label><input type="text" id="prodName" class="custom-input" required /></div>
            <div class="form-group"><label for="prodCategory">Category</label><select id="prodCategory" class="custom-select" required><option value="oud">Oud & Heritage</option><option value="fresh">Aquatic & Fresh</option><option value="floral">Floral & Rose</option><option value="gourmand">Gourmand & Amber</option></select></div>
            <div class="form-group"><label for="prodFamily">Scent Family</label><input type="text" id="prodFamily" class="custom-input" placeholder="e.g. Woody, Floral" required /></div>
            <div class="form-group"><label for="prodDesc">Description</label><textarea id="prodDesc" class="custom-input custom-textarea" rows="3" required></textarea></div>
            <div class="size-qty-row">
                <div class="form-group" style="flex:1; margin-right:0.5rem;"><label>6ml Price (₹)</label><input type="number" id="prodPrice6" class="custom-input" required /></div>
                <div class="form-group" style="flex:1;"><label>12ml Price (₹)</label><input type="number" id="prodPrice12" class="custom-input" required /></div>
            </div>
            <button type="submit" class="btn-gold checkout-btn" style="margin-top:1rem;">SAVE TO CATALOG</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // --- 1. FETCH DASHBOARD DATA ---
        async function loadDashboardData() {
            try {
                // TODO: Replace with actual API calls
                // const statsRes = await fetch('/api/admin/stats');
                // const ordersRes = await fetch('/api/admin/orders');
                // const stats = await statsRes.json();
                // const orders = await ordersRes.json();

                // Simulated data (REMOVE IN PRODUCTION)
                const stats = { totalRevenue: 148250, totalProducts: 34, totalOrders: 3, totalClients: 184 };
                const orders = [
                    { id: '#AAD-1048', customer: 'Ananya Sharma', items: 'Kesar Chandan (12ml), Oud Al Noor (6ml)', total: 1097.40, status: 'Processing' },
                    { id: '#AAD-1047', customer: 'Priya S.', items: 'Turkish Rose (12ml)', total: 885.00, status: 'Dispatched' },
                    { id: '#AAD-1046', customer: 'Rahul M.', items: 'Black Oud (12ml)', total: 1298.00, status: 'Delivered' }
                ];

                // Update Stats
                document.getElementById('statRevenue').innerText = '₹' + stats.totalRevenue.toLocaleString('en-IN');
                document.getElementById('statProducts').innerText = stats.totalProducts;
                document.getElementById('statOrders').innerText = stats.totalOrders;
                document.getElementById('statClients').innerText = stats.totalClients;

                // Render Orders
                renderOrders(orders);

            } catch (error) {
                console.error('Failed to load dashboard:', error);
            }
        }

        // --- 2. RENDER ORDERS ---
        function renderOrders(orders) {
            const tbody = document.getElementById('adminOrdersTbody');
            tbody.innerHTML = '';

            orders.forEach(order => {
                const statusClass = order.status.toLowerCase();
                const tr = document.createElement('tr');
                tr.dataset.status = order.status;

                let actionsHtml = '';
                if (order.status === 'Processing') {
                    actionsHtml = `<button class="btn-outline admin-sm-btn" onclick="updateOrderStatus('${order.id}', 'Dispatched')">Mark Dispatched</button>
                                           <button class="btn-outline admin-sm-btn btn-danger" onclick="rejectOrder('${order.id}')">Reject</button>`;
                } else if (order.status === 'Dispatched') {
                    actionsHtml = `<button class="btn-outline admin-sm-btn" onclick="updateOrderStatus('${order.id}', 'Delivered')">Mark Delivered</button>
                                           <button class="btn-outline admin-sm-btn btn-danger" onclick="rejectOrder('${order.id}')">Reject</button>`;
                } else {
                    actionsHtml = `<span class="status-text-completed">Completed</span>`;
                }

                tr.innerHTML = `
                            <td><strong>${order.id}</strong></td>
                            <td><div class="client-contact-info"><strong>${order.customer}</strong><div class="contact-links"><a href="https://wa.me/919824292270?text=Hello%20${encodeURIComponent(order.customer)}" target="_blank" class="contact-btn whatsapp">💬 WhatsApp</a><a href="mailto:customer@example.com" class="contact-btn email">✉️ Email</a></div></div></td>
                            <td>${order.items}</td>
                            <td>₹${order.total.toFixed(2)}</td>
                            <td><span class="status-pill status-${statusClass}">${order.status}</span></td>
                            <td style="text-align: right;">${actionsHtml}</td>
                        `;
                tbody.appendChild(tr);
            });
        }

        // --- 3. ORDER OPERATIONS (API CALLS) ---
        async function updateOrderStatus(orderId, newStatus) {
            if (!confirm(`Update ${orderId} to ${newStatus}?`)) return;
            try {
                // TODO: await fetch(`/api/admin/orders/${orderId}/status`, { method: 'PUT', body: JSON.stringify({ status: newStatus }) });
                alert(`[SIMULATED] ${orderId} updated to ${newStatus}.`);
                // Refresh UI or update row manually
                const rows = document.querySelectorAll('#adminOrdersTbody tr');
                rows.forEach(row => {
                    if (row.querySelector('td strong').innerText === orderId) {
                        row.dataset.status = newStatus;
                        const statusTd = row.children[4];
                        statusTd.innerHTML = `<span class="status-pill status-${newStatus.toLowerCase()}">${newStatus}</span>`;
                        // Update actions
                        const actionTd = row.children[5];
                        if (newStatus === 'Dispatched') {
                            actionTd.innerHTML = `<button class="btn-outline admin-sm-btn" onclick="updateOrderStatus('${orderId}', 'Delivered')">Mark Delivered</button>
                                                           <button class="btn-outline admin-sm-btn btn-danger" onclick="rejectOrder('${orderId}')">Reject</button>`;
                        } else if (newStatus === 'Delivered') {
                            actionTd.innerHTML = `<span class="status-text-completed">Completed</span>`;
                        }
                    }
                });
            } catch (error) { alert('Failed to update status.'); }
        }

        async function rejectOrder(orderId) {
            const reason = prompt(`Provide a valid reason for rejecting ${orderId}:`);
            if (!reason || reason.trim() === "") return;
            try {
                // TODO: await fetch(`/api/admin/orders/${orderId}/reject`, { method: 'PUT', body: JSON.stringify({ reason: reason }) });
                alert(`[SIMULATED] ${orderId} rejected. Reason: ${reason}`);
                // Remove or mark row
                const rows = document.querySelectorAll('#adminOrdersTbody tr');
                rows.forEach(row => {
                    if (row.querySelector('td strong').innerText === orderId) {
                        row.dataset.status = 'Cancelled';
                        const statusTd = row.children[4];
                        statusTd.innerHTML = `<span class="status-pill status-cancelled">Cancelled</span><br><small style="color:#d32f2f;font-size:0.7rem;">Reason: ${reason}</small>`;
                        row.children[5].innerHTML = `<span style="font-size:0.75rem;color:#888;">Rejected</span>`;
                    }
                });
            } catch (error) { alert('Failed to reject order.'); }
        }

        // --- 4. ADD PRODUCT (API CALL) ---
        async function handleCreateProduct(e) {
            e.preventDefault();
            const payload = {
                name: document.getElementById('prodName').value,
                category: document.getElementById('prodCategory').value,
                scentFamily: document.getElementById('prodFamily').value,
                description: document.getElementById('prodDesc').value,
                price6ml: parseFloat(document.getElementById('prodPrice6').value),
                price12ml: parseFloat(document.getElementById('prodPrice12').value)
            };

            try {
                // TODO: await fetch('/api/admin/products', { method: 'POST', body: JSON.stringify(payload) });
                alert(`[SIMULATED] Fragrance "${payload.name}" saved to catalog!`);
                closeAddProductDrawer();
                document.getElementById('addProductForm').reset();
                loadDashboardData(); // Refresh stats
            } catch (error) {
                alert('Failed to add product.');
            }
        }

        // --- 5. DRAWER CONTROLS ---
        function openAddProductDrawer() {
            document.getElementById('addProductOverlay').classList.add('open');
            document.getElementById('addProductDrawer').classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closeAddProductDrawer() {
            document.getElementById('addProductOverlay').classList.remove('open');
            document.getElementById('addProductDrawer').classList.remove('open');
            document.body.style.overflow = 'auto';
        }

        // --- 6. FILTER ORDERS ---
        document.getElementById('orderFilterPills').addEventListener('click', (e) => {
            if (e.target.classList.contains('filter-btn')) {
                document.querySelectorAll('#orderFilterPills .filter-btn').forEach(b => b.classList.remove('active'));
                e.target.classList.add('active');
                const status = e.target.dataset.status;
                document.querySelectorAll('#adminOrdersTbody tr').forEach(row => {
                    row.style.display = (status === 'all' || row.dataset.status === status) ? '' : 'none';
                });
            }
        });

        // --- INIT ---
        loadDashboardData();
    </script>
}