﻿@{
ViewData["Title"] = "Admin Operations Dashboard - House of AADYA";
}

<section class="section-padding" style="padding-top: 2rem;">
    <!-- ADMIN HEADER -->
    <div class="admin-header">
        <div>
            <h1 class="admin-title">Real-Time Management Dashboard</h1>
        </div>
        <button class="btn-gold" onclick="openAddProductDrawer()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="16" />
                <line x1="8" y1="12" x2="16" y2="12" />
            </svg>
            ADD NEW FRAGRANCE
        </button>
    </div>

    <!-- STATS CARDS -->
    <div class="admin-stats-grid" id="adminStatsGrid">
        <div class="stat-card"><span class="stat-label">Total Sales Revenue</span><div class="stat-value" id="statRevenue">₹0</div><span class="stat-sub text-green">Loading...</span></div>
        <div class="stat-card"><span class="stat-label">Catalog Products</span><div class="stat-value" id="statProducts">0</div><span class="stat-sub">100% Alcohol-Free</span></div>
        <div class="stat-card"><span class="stat-label">Total Orders</span><div class="stat-value" id="statOrders">0</div><span class="stat-sub">Live Transaction Logs</span></div>
        <div class="stat-card"><span class="stat-label">Registered Clients</span><div class="stat-value" id="statClients">0</div><span class="stat-sub">Secure User Database</span></div>
    </div>

    <!-- CUSTOMER SEGMENTS -->
    <div style="margin-bottom: 2rem; margin-top: 1.5rem;">
        <h3 style="font-family: var(--font-heading); color: var(--deep-burgundy); margin-bottom: 1rem;">Customer Segments</h3>
        <div class="admin-stats-grid" id="customerSegmentsGrid">
            <div class="stat-card">
                <span class="stat-label">High Spenders</span>
                <div class="stat-value" id="segHighSpenders">Loading...</div>
                <span class="stat-sub">Total spent > ₹5,000</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Regular</span>
                <div class="stat-value" id="segRegular">Loading...</div>
                <span class="stat-sub">₹1,000 – ₹5,000</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Occasional</span>
                <div class="stat-value" id="segOccasional">Loading...</div>
                <span class="stat-sub">Up to ₹1,000</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Inactive</span>
                <div class="stat-value" id="segInactive">Loading...</div>
                <span class="stat-sub">No orders yet</span>
            </div>
        </div>
    </div>

    <!-- TAB NAVIGATION -->
    <div style="display:flex; gap:1rem; margin-bottom:2rem; border-bottom:1px solid var(--border-color); padding-bottom:0.5rem; flex-wrap:wrap;">
        <button class="filter-btn active" data-tab="orders" onclick="switchTab('orders')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                <rect x="2" y="3" width="20" height="18" rx="2" />
                <line x1="8" y1="9" x2="16" y2="9" />
                <line x1="8" y1="13" x2="16" y2="13" />
                <line x1="8" y1="17" x2="12" y2="17" />
            </svg>
            Orders
        </button>
        <button class="filter-btn" data-tab="products" onclick="switchTab('products')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                <rect x="2" y="2" width="20" height="20" rx="2" />
                <line x1="8" y1="8" x2="16" y2="8" />
                <line x1="8" y1="12" x2="16" y2="12" />
                <line x1="8" y1="16" x2="12" y2="16" />
            </svg>
            Products
        </button>
        <button class="filter-btn" data-tab="users" onclick="switchTab('users')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
            Users
        </button>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 1: ORDERS -->
    <!-- ============================================================ -->
    <div id="tabOrders" class="admin-table-card">
        <div class="admin-table-header-row">
            <h3 class="table-card-title">Order Management & Fulfillment Logs</h3>
            <div class="admin-filter-pills" id="orderFilterPills">
                <button class="filter-btn active" data-status="all">All Orders</button>
                <button class="filter-btn" data-status="Processing">Processing</button>
                <button class="filter-btn" data-status="Dispatched">Dispatched</button>
                <button class="filter-btn" data-status="Delivered">Delivered</button>
                <button class="filter-btn" data-status="Cancelled">Cancelled</button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr><th>Order ID</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th style="text-align: right;">Actions</th></tr>
                </thead>
                <tbody id="adminOrdersTbody">
                    <tr><td colspan="6" style="text-align:center; padding:2rem;">Loading orders...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 2: PRODUCTS -->
    <!-- ============================================================ -->
    <div id="tabProducts" style="display:none;" class="admin-table-card">
        <div class="admin-table-header-row">
            <h3 class="table-card-title">Product Catalog</h3>
            <button class="btn-gold" onclick="openAddProductDrawer()" style="font-size:0.75rem; padding:0.4rem 1rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:4px;">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="16" />
                    <line x1="8" y1="12" x2="16" y2="12" />
                </svg>
                ADD PRODUCT
            </button>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr><th>Image</th><th>Name</th><th>Category</th><th>Price (6ml/12ml)</th><th>Stock</th><th style="text-align: right;">Actions</th></tr>
                </thead>
                <tbody id="adminProductsTbody">
                    <tr><td colspan="6" style="text-align:center; padding:2rem;">Loading products...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 3: USERS -->
    <!-- ============================================================ -->
    <div id="tabUsers" style="display:none;" class="admin-table-card">
        <div class="admin-table-header-row">
            <h3 class="table-card-title">User Management</h3>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr><th>Name</th><th>Phone</th><th>Email</th><th>Address</th><th style="text-align: right;">Action</th></tr>
                </thead>
                <tbody id="adminUsersTbody">
                    <tr><td colspan="5" style="text-align:center; padding:2rem;">Loading users...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- ADD PRODUCT SLIDING DRAWER -->
<!-- ============================================================ -->
<div class="drawer-overlay" id="addProductOverlay" onclick="closeAddProductDrawer()"></div>
<div class="product-drawer" id="addProductDrawer">
    <button class="drawer-close-btn" onclick="closeAddProductDrawer()">&times;</button>
    <div class="drawer-content">
        <h2 class="drawer-title">Add New Fragrance</h2>
        <p class="drawer-desc">Fill in the details to add a new product to the catalog.</p>

        <form id="addProductForm" class="auth-form">
            <div class="form-group">
                <label for="prodName">Fragrance Title</label>
                <input type="text" id="prodName" class="custom-input" required />
            </div>
            <div class="form-group">
                <label for="prodCategory">Category</label>
                <select id="prodCategory" class="custom-select" required>
                    <option value="Signature Blends">Signature Blends</option>
                    <option value="Attars & Oud">Attars & Oud</option>
                    <option value="Contemporary Fragrances">Contemporary Fragrances</option>
                </select>
            </div>
            <div class="form-group">
                <label for="prodFamily">Scent Family</label>
                <input type="text" id="prodFamily" class="custom-input" placeholder="e.g. Woody, Floral" required />
            </div>
            <div class="form-group">
                <label for="prodDesc">Description</label>
                <textarea id="prodDesc" class="custom-input custom-textarea" rows="3" required></textarea>
            </div>
            <div class="form-group">
                <label for="prodImage">Product Image</label>
                <input type="file" id="prodImage" accept="image/*" />
                <div id="imagePreview" style="margin-top:0.5rem; max-width:100px; display:none;">
                    <img id="previewImg" src="#" alt="Preview" style="width:100%; border:1px solid var(--border-color); border-radius:4px;" />
                </div>
            </div>
            <div class="size-qty-row">
                <div class="form-group" style="flex:1; margin-right:0.5rem;">
                    <label>6ml Price (₹)</label>
                    <input type="number" id="prodPrice6" class="custom-input" required />
                </div>
                <div class="form-group" style="flex:1;">
                    <label>12ml Price (₹)</label>
                    <input type="number" id="prodPrice12" class="custom-input" required />
                </div>
            </div>
            <button type="submit" class="btn-gold checkout-btn" style="margin-top:1rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                    <polyline points="17 21 17 13 7 13 7 21" />
                    <polyline points="7 3 7 8 15 8" />
                </svg>
                SAVE TO CATALOG
            </button>
        </form>
    </div>
</div>

<!-- STOCK UPDATE MODAL -->
<div id="stockModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9998; align-items:center; justify-content:center;">
    <div style="background:white; padding:2rem; border-radius:8px; max-width:420px; text-align:center; box-shadow:0 4px 20px rgba(0,0,0,0.3); width:90%;">
        <h3 style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 0.5rem 0;">Update Stock</h3>
        <p style="color:var(--text-muted); margin:0 0 1rem 0;">Enter the new stock quantity for <strong id="stockProductName"></strong></p>
        <div class="form-group">
            <label for="stockInput">Stock Quantity</label>
            <input type="number" id="stockInput" class="custom-input" style="width:100%; text-align:center; font-size:1.2rem; padding:0.5rem;" min="0" />
        </div>
        <div style="display:flex; gap:1rem; justify-content:center; margin-top:1.5rem;">
            <button id="stockConfirmBtn" class="btn-gold">Update</button>
            <button id="stockCancelBtn" class="btn-outline">Cancel</button>
        </div>
    </div>
</div>

<!-- REJECT ORDER REASON MODAL -->
<div id="reasonModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9998; align-items:center; justify-content:center;">
    <div style="background:white; padding:2rem; border-radius:8px; max-width:420px; text-align:center; box-shadow:0 4px 20px rgba(0,0,0,0.3); width:90%;">
        <h3 style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 0.5rem 0;">Reject Order</h3>
        <p style="color:var(--text-muted); margin:0 0 1rem 0;">Please provide a reason for rejecting <strong id="rejectOrderId"></strong></p>
        <div class="form-group">
            <label for="reasonInput">Reason</label>
            <textarea id="reasonInput" class="custom-input custom-textarea" rows="3" style="width:100%;" placeholder="e.g. Out of stock, Customer request, etc."></textarea>
        </div>
        <div style="display:flex; gap:1rem; justify-content:center; margin-top:1.5rem;">
            <button id="reasonConfirmBtn" class="btn-gold">Reject Order</button>
            <button id="reasonCancelBtn" class="btn-outline">Cancel</button>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- CONFIRMATION MODAL -->
<!-- ============================================================ -->
<div id="confirmModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; padding:2rem; border-radius:8px; max-width:420px; text-align:center; box-shadow:0 4px 20px rgba(0,0,0,0.3); width:90%;">
        <div id="modalIcon" style="font-size:3rem; margin-bottom:0.5rem;">⚠️</div>
        <h3 id="modalTitle" style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 0.5rem 0;">Confirm Action</h3>
        <p id="modalMessage" style="color:var(--text-muted); margin:0 0 1.5rem 0; line-height:1.6;"></p>
        <div style="display:flex; gap:1rem; justify-content:center;">
            <button id="modalConfirmBtn" class="btn-gold">Yes, Proceed</button>
            <button id="modalCancelBtn" class="btn-outline">Cancel</button>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- USER ORDERS MODAL -->
<!-- ============================================================ -->
<div id="userOrdersModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9998; align-items:center; justify-content:center; overflow-y:auto;">
    <div style="background:white; padding:2rem; border-radius:8px; max-width:600px; width:90%; max-height:80vh; overflow-y:auto; box-shadow:0 4px 20px rgba(0,0,0,0.3);">
        <h3 id="userOrdersTitle" style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 1rem 0;">Orders for <span id="userOrdersName"></span></h3>
        <div id="userOrdersList"></div>
        <div style="text-align:center; margin-top:1rem;">
            <button class="btn-outline" onclick="closeUserOrders()">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let activeTab = 'orders';
        let currentProductId = null;

        // --- 1. TAB SWITCHING ---
        function switchTab(tab) {
            activeTab = tab;
            document.querySelectorAll('.filter-btn[data-tab]').forEach(b => b.classList.remove('active'));
            document.querySelector(`.filter-btn[data-tab="${tab}"]`).classList.add('active');

            document.getElementById('tabOrders').style.display = tab === 'orders' ? 'block' : 'none';
            document.getElementById('tabProducts').style.display = tab === 'products' ? 'block' : 'none';
            document.getElementById('tabUsers').style.display = tab === 'users' ? 'block' : 'none';

            if (tab === 'orders') loadOrders();
            if (tab === 'products') loadProducts();
            if (tab === 'users') loadUsers();
        }

        // --- 2. LOAD DASHBOARD STATS ---
        async function loadStats() {
            const token = localStorage.getItem('token');
            if (!token) return;
            try {
                const res = await fetch('/api/admin/stats', { headers: { 'Authorization': 'Bearer ' + token } });
                if (!res.ok) throw new Error('Failed to load stats');
                const stats = await res.json();
                document.getElementById('statRevenue').innerText = '₹' + stats.totalRevenue.toLocaleString('en-IN');
                document.getElementById('statProducts').innerText = stats.totalProducts;
                document.getElementById('statOrders').innerText = stats.totalOrders;
                document.getElementById('statClients').innerText = stats.totalClients;
            } catch (error) {
                console.error('Error loading stats:', error);
                document.querySelectorAll('.stat-value').forEach(el => el.innerText = 'Error');
            }
        }

        // --- 3. LOAD ORDERS ---
        async function loadOrders() {
            const token = localStorage.getItem('token');
            if (!token) return;
            const tbody = document.getElementById('adminOrdersTbody');
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem;">Loading orders...</td></tr>';
            try {
                const res = await fetch('/api/admin/orders', { headers: { 'Authorization': 'Bearer ' + token } });
                if (!res.ok) throw new Error('Failed to load orders');
                const orders = await res.json();
                renderOrders(orders);
            } catch (error) {
                console.error('Error loading orders:', error);
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem; color:red;">Failed to load orders.</td></tr>';
            }
        }

        function renderOrders(orders) {
            const tbody = document.getElementById('adminOrdersTbody');
            tbody.innerHTML = '';
            if (!orders || orders.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem;">No orders found.</td></tr>';
                return;
            }
            orders.forEach(order => {
                const statusClass = order.status.toLowerCase();
                const tr = document.createElement('tr');
                tr.dataset.status = order.status;
                let actionsHtml = '';
                if (order.status === 'Processing') {
                    actionsHtml = `
                                        <button class="btn-outline admin-sm-btn" onclick="updateOrderStatus('${order.id}', 'Dispatched')">Mark Dispatched</button>
                                        <button class="btn-outline admin-sm-btn btn-danger" onclick="rejectOrder('${order.id}')">Reject</button>
                                    `;
                } else if (order.status === 'Dispatched') {
                    actionsHtml = `
                                        <button class="btn-outline admin-sm-btn" onclick="updateOrderStatus('${order.id}', 'Delivered')">Mark Delivered</button>
                                        <button class="btn-outline admin-sm-btn btn-danger" onclick="rejectOrder('${order.id}')">Reject</button>
                                    `;
                } else {
                    actionsHtml = `<span class="status-text-completed">Completed</span>`;
                }
                // Replace WhatsApp and Email emojis with SVGs
                const whatsappIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`;
                const emailIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:4px;"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6L12 13 2 6"/></svg>`;

                tr.innerHTML = `
                                    <td><strong>${order.id}</strong></td>
                                    <td><div class="client-contact-info"><strong>${order.customer}</strong><div class="contact-links"><a href="https://wa.me/919824292270?text=Hello%20${encodeURIComponent(order.customer)}" target="_blank" class="contact-btn whatsapp">${whatsappIcon}WhatsApp</a><a href="mailto:customer@example.com" class="contact-btn email">${emailIcon}Email</a></div></div></td>
                                    <td>${order.items}</td>
                                    <td>₹${order.total.toFixed(2)}</td>
                                    <td><span class="status-pill status-${statusClass}">${order.status}</span></td>
                                    <td style="text-align: right;">${actionsHtml}</td>
                                `;
                tbody.appendChild(tr);
            });
        }

        // --- 4. ORDER ACTIONS ---
        async function updateOrderStatus(orderId, newStatus) {
            showModal('🔄', 'Update Status', `Are you sure you want to mark ${orderId} as ${newStatus}?`, async function () {
                const token = localStorage.getItem('token');
                try {
                    const res = await fetch(`/api/admin/orders/${orderId}/status`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                        body: JSON.stringify({ status: newStatus })
                    });
                    const data = await res.json();
                    if (res.ok) {
                        showToast(data.message, 'success');
                        loadOrders();
                        loadStats();
                    } else {
                        showToast(data.message || 'Failed to update status.', 'error');
                    }
                } catch (error) {
                    showToast('Network error.', 'error');
                }
            });
        }

        // --- 5. LOAD PRODUCTS ---
        async function loadProducts() {
            const token = localStorage.getItem('token');
            if (!token) return;
            const tbody = document.getElementById('adminProductsTbody');
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem;">Loading products...</td></tr>';
            try {
                const res = await fetch('/api/admin/products', { headers: { 'Authorization': 'Bearer ' + token } });
                if (!res.ok) throw new Error('Failed to load products');
                const products = await res.json();
                renderProducts(products);
            } catch (error) {
                console.error('Error loading products:', error);
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem; color:red;">Failed to load products.</td></tr>';
            }
        }

        function renderProducts(products) {
            const tbody = document.getElementById('adminProductsTbody');
            tbody.innerHTML = '';
            if (!products || products.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem;">No products found.</td></tr>';
                return;
            }
            products.forEach(p => {
                const variants = p.variants || [];
                const price6 = variants.find(v => v.size === '6ml')?.price || 0;
                const price12 = variants.find(v => v.size === '12ml')?.price || 0;
                const stock = variants.length > 0 ? variants[0].stockQuantity : 0;
                const tr = document.createElement('tr');
                // Delete icon (trash) SVG
                const deleteIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:4px;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>`;
                tr.innerHTML = `
                                    <td><img src="${p.imageUrl || 'https://via.placeholder.com/50'}" alt="${p.name}" style="width:50px; height:50px; object-fit:cover; border-radius:4px; border:1px solid var(--border-color);" onerror="this.src='https://via.placeholder.com/50'"></td>
                                    <td><strong>${p.name}</strong></td>
                                    <td>${p.categoryName}</td>
                                    <td>₹${price6} / ₹${price12}</td>
                                    <td>${stock}</td>
                                    <td style="text-align: right;">
                                        <button class="btn-outline admin-sm-btn" onclick="updateStock(${p.productId}, ${stock})">Update Stock</button>
                                        <button class="btn-outline admin-sm-btn btn-danger" onclick="deleteProduct(${p.productId}, '${p.name}')">${deleteIcon}Delete</button>
                                    </td>
                                `;
                tbody.appendChild(tr);
            });
        }

        // --- UPDATE STOCK with themed modal ---
        let stockProductId = null;

        function updateStock(productId, currentStock, productName) {
            stockProductId = productId;
            document.getElementById('stockProductName').innerText = productName;
            document.getElementById('stockInput').value = currentStock;
            document.getElementById('stockModal').style.display = 'flex';
            document.getElementById('stockInput').focus();
            document.getElementById('stockInput').select();
        }

        document.getElementById('stockConfirmBtn').addEventListener('click', async function () {
            const newStock = parseInt(document.getElementById('stockInput').value);
            if (isNaN(newStock) || newStock < 0) {
                showToast('Please enter a valid stock number (0 or greater).', 'error');
                return;
            }
            document.getElementById('stockModal').style.display = 'none';
            const token = localStorage.getItem('token');
            try {
                const res = await fetch(`/api/admin/products/${stockProductId}/stock`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ stockQuantity: newStock })
                });
                const data = await res.json();
                if (res.ok) {
                    showToast(data.message, 'success');
                    loadProducts();
                } else {
                    showToast(data.message || 'Failed to update stock.', 'error');
                }
            } catch (error) {
                showToast('Network error.', 'error');
            }
            stockProductId = null;
        });

        document.getElementById('stockCancelBtn').addEventListener('click', function () {
            document.getElementById('stockModal').style.display = 'none';
            stockProductId = null;
        });

        // Close modal on outside click
        document.getElementById('stockModal').addEventListener('click', function (e) {
            if (e.target === this) {
                this.style.display = 'none';
                stockProductId = null;
            }
        });

        // --- REJECT ORDER with themed modal ---
        let rejectOrderId = null;

        function rejectOrder(orderId) {
            rejectOrderId = orderId;
            document.getElementById('rejectOrderId').innerText = orderId;
            document.getElementById('reasonInput').value = '';
            document.getElementById('reasonModal').style.display = 'flex';
            document.getElementById('reasonInput').focus();
        }

        document.getElementById('reasonConfirmBtn').addEventListener('click', async function() {
            const reason = document.getElementById('reasonInput').value.trim();
            if (!reason) {
                showToast('Please provide a reason for rejecting the order.', 'error');
                return;
            }
            document.getElementById('reasonModal').style.display = 'none';
            const token = localStorage.getItem('token');
            try {
                const res = await fetch(`/api/admin/orders/${rejectOrderId}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({
                        status: 'Cancelled',
                        reason: reason
                    })
                });
                const data = await res.json();
                if (res.ok) {
                    showToast(`Order ${rejectOrderId} rejected. Reason: ${reason}`, 'error');
                    loadOrders();
                    loadStats();
                } else {
                    showToast(data.message || 'Failed to reject order.', 'error');
                }
            } catch (error) {
                showToast('Network error.', 'error');
            }
            rejectOrderId = null;
        });

        document.getElementById('reasonCancelBtn').addEventListener('click', function () {
            document.getElementById('reasonModal').style.display = 'none';
            rejectOrderId = null;
        });

        // Close modal on outside click
        document.getElementById('reasonModal').addEventListener('click', function (e) {
            if (e.target === this) {
                this.style.display = 'none';
                rejectOrderId = null;
            }
        });

        async function deleteProduct(productId, productName) {
            showModal('🗑️', 'Delete Product', `Are you sure you want to permanently delete <strong>${productName}</strong>? This action cannot be undone.`, async function () {
                const token = localStorage.getItem('token');
                try {
                    const res = await fetch(`/api/admin/products/${productId}`, {
                        method: 'DELETE',
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                    const data = await res.json();
                    if (res.ok) {
                        showToast(data.message, 'success');
                        loadProducts();
                        loadStats();
                    } else {
                        showToast(data.message || 'Failed to delete product.', 'error');
                    }
                } catch (error) {
                    showToast('Network error.', 'error');
                }
            });
        }

        // --- 7. ADD PRODUCT ---
        document.getElementById('prodImage').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    document.getElementById('previewImg').src = event.target.result;
                    document.getElementById('imagePreview').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('addProductForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const token = localStorage.getItem('token');
            if (!token) return;

            const imageFile = document.getElementById('prodImage').files[0];
            let imageBase64 = '';
            if (imageFile) {
                const reader = new FileReader();
                const dataUrl = await new Promise(resolve => {
                    reader.onload = ev => resolve(ev.target.result);
                    reader.readAsDataURL(imageFile);
                });
                imageBase64 = dataUrl;
            }

            const payload = {
                name: document.getElementById('prodName').value.trim(),
                category: document.getElementById('prodCategory').value,
                scentFamily: document.getElementById('prodFamily').value.trim(),
                description: document.getElementById('prodDesc').value.trim(),
                imageUrl: imageBase64 || '',
                price6ml: parseFloat(document.getElementById('prodPrice6').value),
                price12ml: parseFloat(document.getElementById('prodPrice12').value)
            };

            try {
                const res = await fetch('/api/admin/products', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (res.ok) {
                    showToast(data.message, 'success');
                    closeAddProductDrawer();
                    document.getElementById('addProductForm').reset();
                    document.getElementById('imagePreview').style.display = 'none';
                    loadProducts();
                    loadStats();
                } else {
                    showToast(data.message || 'Failed to add product.', 'error');
                }
            } catch (error) {
                showToast('Network error.', 'error');
            }
        });

        // --- 8. LOAD USERS ---
        async function loadUsers() {
            const token = localStorage.getItem('token');
            if (!token) return;
            const tbody = document.getElementById('adminUsersTbody');
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:2rem;">Loading users...</td></tr>';
            try {
                const res = await fetch('/api/admin/users', { headers: { 'Authorization': 'Bearer ' + token } });
                if (!res.ok) throw new Error('Failed to load users');
                const users = await res.json();
                renderUsers(users);
            } catch (error) {
                console.error('Error loading users:', error);
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:2rem; color:red;">Failed to load users.</td></tr>';
            }
        }

        function renderUsers(users) {
            const tbody = document.getElementById('adminUsersTbody');
            tbody.innerHTML = '';
            if (!users || users.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem;">No users found.</td></tr>';
                return;
            }

            // Get current user's super admin status (stored in localStorage)
            const isSuperAdmin = localStorage.getItem('isSuperAdmin') === 'true';

            users.forEach(user => {
                const tr = document.createElement('tr');
                let actionsHtml = '';

                // Determine if current user is the super admin (to show/hide action buttons)
                const isCurrentUser = user.userId === parseInt(localStorage.getItem('userId'));

                if (user.isAdmin) {
                    // Admin user
                    let adminBadge = '<span class="status-pill status-processing" style="background:#CBA463; color:#fff;">Admin</span>';
                    if (user.isSuperAdmin) {
                        adminBadge = '<span class="status-pill status-processing" style="background:var(--deep-burgundy); color:var(--warm-ivory);">Super Admin</span>';
                    }
                    // Only show "Demote" button if current user is super admin and this is NOT the super admin themselves
                    if (isSuperAdmin && !user.isSuperAdmin) {
                        actionsHtml = `
                            <button class="btn-outline admin-sm-btn" onclick="viewUserOrders(${user.userId}, '${user.fullName}')">View Orders</button>
                            <button class="btn-outline admin-sm-btn btn-danger" onclick="demoteUser(${user.userId}, '${user.fullName}')">Demote</button>
                        `;
                    } else if (isSuperAdmin && user.isSuperAdmin) {
                        actionsHtml = `<span style="color:var(--text-muted); font-size:0.8rem;">(You)</span>`;
                    } else {
                        actionsHtml = `<span style="color:var(--text-muted); font-size:0.8rem;">No actions</span>`;
                    }
                    tr.innerHTML = `
                        <td><strong>${user.fullName}</strong> ${adminBadge}</td>
                        <td>${user.phoneNumber || 'N/A'}</td>
                        <td>${user.email}</td>
                        <td>${user.address || 'N/A'}</td>
                        <td style="text-align: right;">${actionsHtml}</td>
                    `;
                } else {
                    // Normal user
                    // Only show "Make Admin" button if current user is super admin
                    if (isSuperAdmin) {
                        actionsHtml = `
                            <button class="btn-outline admin-sm-btn" onclick="viewUserOrders(${user.userId}, '${user.fullName}')">View Orders</button>
                            <button class="btn-outline admin-sm-btn" onclick="promoteUser(${user.userId}, '${user.fullName}')">Make Admin</button>
                        `;
                    } else {
                        actionsHtml = `
                            <button class="btn-outline admin-sm-btn" onclick="viewUserOrders(${user.userId}, '${user.fullName}')">View Orders</button>
                        `;
                    }
                    tr.innerHTML = `
                        <td><strong>${user.fullName}</strong></td>
                        <td>${user.phoneNumber || 'N/A'}</td>
                        <td>${user.email}</td>
                        <td>${user.address || 'N/A'}</td>
                        <td style="text-align: right;">${actionsHtml}</td>
                    `;
                }
                tbody.appendChild(tr);
            });
        }

        // --- 9. VIEW USER ORDERS ---
        async function viewUserOrders(userId, userName) {
            document.getElementById('userOrdersName').innerText = userName;
            document.getElementById('userOrdersList').innerHTML = 'Loading orders...';
            document.getElementById('userOrdersModal').style.display = 'flex';

            const token = localStorage.getItem('token');
            try {
                const res = await fetch(`/api/admin/users/${userId}/orders`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (!res.ok) throw new Error('Failed to load user orders');
                const orders = await res.json();
                renderUserOrders(orders);
            } catch (error) {
                document.getElementById('userOrdersList').innerHTML = '<p style="color:red;">Failed to load orders.</p>';
                console.error(error);
            }
        }

        function renderUserOrders(orders) {
            const container = document.getElementById('userOrdersList');
            if (!orders || orders.length === 0) {
                container.innerHTML = '<p style="color:var(--text-muted); text-align:center;">No orders found for this user.</p>';
                return;
            }
            let html = '';
            orders.forEach(o => {
                html += `
                                    <div style="background:var(--warm-ivory); border:1px solid var(--border-color); border-radius:4px; padding:1rem; margin-bottom:1rem;">
                                        <div style="display:flex; justify-content:space-between; flex-wrap:wrap;">
                                            <strong>Order #${o.orderId}</strong>
                                            <span class="status-pill status-${o.orderStatus.toLowerCase()}">${o.orderStatus}</span>
                                        </div>
                                        <p style="margin:0.2rem 0;">Total: ₹${o.totalAmount.toFixed(2)}</p>
                                        <p style="margin:0.2rem 0; font-size:0.85rem; color:var(--text-muted);">${new Date(o.createdAt).toLocaleDateString()}</p>
                                        <p style="margin:0.2rem 0; font-size:0.85rem; color:var(--text-muted);">Shipping: ${o.shippingAddress}</p>
                                        <div style="margin-top:0.5rem;">
                                            <strong>Items:</strong>
                                            <ul style="list-style:none; padding:0; margin:0.2rem 0;">
                                                ${o.items.map(item => `<li style="font-size:0.85rem; padding:0.1rem 0;">${item.productName} (${item.size}) × ${item.quantity} = ₹${item.total.toFixed(2)}</li>`).join('')}
                                            </ul>
                                        </div>
                                    </div>
                                `;
            });
            container.innerHTML = html;
        }

        function closeUserOrders() {
            document.getElementById('userOrdersModal').style.display = 'none';
        }

        // --- 10. DRAWER CONTROLS ---
        function openAddProductDrawer() {
            document.getElementById('addProductOverlay').classList.add('open');
            document.getElementById('addProductDrawer').classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeAddProductDrawer() {
            document.getElementById('addProductOverlay').classList.remove('open');
            document.getElementById('addProductDrawer').classList.remove('open');
            document.body.style.overflow = 'auto';
        }

        // --- 11. CONFIRMATION MODAL ---
        function showModal(icon, title, message, onConfirm) {
            document.getElementById('modalIcon').innerHTML = icon;
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalMessage').innerHTML = message;

            const modal = document.getElementById('confirmModal');
            modal.style.display = 'flex';

            document.getElementById('modalConfirmBtn').onclick = function () {
                modal.style.display = 'none';
                if (onConfirm) onConfirm();
            };
            document.getElementById('modalCancelBtn').onclick = function () {
                modal.style.display = 'none';
            };
            modal.onclick = function (e) {
                if (e.target === modal) modal.style.display = 'none';
            };
        }

        // --- 12. ORDER FILTER ---
        document.getElementById('orderFilterPills').addEventListener('click', (e) => {
            if (e.target.classList.contains('filter-btn')) {
                document.querySelectorAll('#orderFilterPills .filter-btn').forEach(b => b.classList.remove('active'));
                e.target.classList.add('active');
                const status = e.target.dataset.status;
                document.querySelectorAll('#adminOrdersTbody tr').forEach(row => {
                    if (row.dataset.status) {
                        row.style.display = (status === 'all' || row.dataset.status === status) ? '' : 'none';
                    }
                });
            }
        });

        // --- 13. INIT ---
        document.addEventListener('DOMContentLoaded', function () {
            loadStats();
            loadOrders(); // default tab
            loadCustomerSegments(); // load customer segments
        });

        // --- PROMOTE USER TO ADMIN ---
        function promoteUser(userId, userName) {
            const crownIcon = `
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:0.5rem; color:var(--champagne-gold);">
                    <path d="M2 18l2-6 3-4 5 3 5-3 3 4 2 6H2z" />
                    <path d="M2 18h20" />
                    <path d="M6 10l-2 2" />
                    <path d="M18 10l2 2" />
                    <path d="M12 8V4" />
                    <path d="M9 4l3-2 3 2" />
                </svg>
            `;
            showModal(
                crownIcon,  // now using SVG instead of emoji
                'Promote to Admin',
                `Are you sure you want to promote <strong>${userName}</strong> to admin? They will gain full access to the admin dashboard.`,
                async function () {
                    const token = localStorage.getItem('token');
                    try {
                        const res = await fetch(`/api/admin/users/${userId}/promote`, {
                            method: 'PUT',
                            headers: { 'Authorization': 'Bearer ' + token }
                        });
                        const data = await res.json();
                        if (res.ok) {
                            showToast(data.message, 'success');
                            loadUsers();   // refresh user list
                            loadStats();   // update client count
                        } else {
                            showToast(data.message || 'Failed to promote user.', 'error');
                        }
                    } catch (error) {
                        showToast('Network error.', 'error');
                    }
                }
            );
        }

        // --- DEMOTE USER FROM ADMIN (only super admin can do this) ---
        function demoteUser(userId, userName) {
            const crownIcon = `
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:0.5rem; color:var(--deep-burgundy);">
                    <path d="M2 18l2-6 3-4 5 3 5-3 3 4 2 6H2z" />
                    <path d="M2 18h20" />
                    <path d="M6 10l-2 2" />
                    <path d="M18 10l2 2" />
                    <path d="M12 8V4" />
                    <path d="M9 4l3-2 3 2" />
                </svg>
            `;
            showModal(
                crownIcon,
                'Demote from Admin',
                `Are you sure you want to remove admin privileges from <strong>${userName}</strong>? They will become a regular user.`,
                async function() {
                    const token = localStorage.getItem('token');
                    try {
                        const res = await fetch(`/api/admin/users/${userId}/demote`, {
                            method: 'PUT',
                            headers: { 'Authorization': 'Bearer ' + token }
                        });
                        const data = await res.json();
                        if (res.ok) {
                            showToast(data.message, 'success');
                            loadUsers();   // refresh user list
                            loadStats();   // update client count
                        } else {
                            showToast(data.message || 'Failed to demote user.', 'error');
                        }
                    } catch (error) {
                        showToast('Network error.', 'error');
                    }
                }
            );
        }

        // --- Load Customer Segments ---
        async function loadCustomerSegments() {
            const token = localStorage.getItem('token');
            if (!token) return;

            try {
                const res = await fetch('/api/admin/customer-segments', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (!res.ok) throw new Error('Failed to load segments');
                const data = await res.json();

                document.getElementById('segHighSpenders').innerText = data.highSpenders || 0;
                document.getElementById('segRegular').innerText = data.regular || 0;
                document.getElementById('segOccasional').innerText = data.occasional || 0;
                document.getElementById('segInactive').innerText = data.inactive || 0;
            } catch (error) {
                console.error('Error loading customer segments:', error);
                document.querySelectorAll('#customerSegmentsGrid .stat-value').forEach(el => el.innerText = 'Error');
            }
        }

    </script>
}