@{
    ViewData["Title"] = "Fragrance Wizard - AADYA: The House of Fragrance";
}

<section class="wizard-hero-banner">
    <div class="wizard-hero-content">
        <span class="wizard-tagline">OBJECTIVE (A): INTERACTIVE CUSTOMIZATION</span>
        <h1 class="wizard-title">The Personal Olfactory Wizard</h1>
        <p class="wizard-subtitle">
            Answer 3 quick questions about your personality and preferences, and our algorithm will recommend your ideal signature attar.
        </p>
    </div>
</section>

<section class="section-padding" style="padding-top: 2.5rem; min-height: 65vh;">
    <div class="wizard-card">

        <!-- STEP INDICATOR BAR -->
        <div class="wizard-steps-indicator">
            <div class="step-dot active" id="stepDot1">1</div>
            <div class="step-line" id="stepLine1"></div>
            <div class="step-dot" id="stepDot2">2</div>
            <div class="step-line" id="stepLine2"></div>
            <div class="step-dot" id="stepDot3">3</div>
        </div>

        <!-- QUESTION STEP 1: PREFERRED SCENT VIBE -->
        <div class="wizard-step-content" id="quizStep1">
            <h2 class="quiz-question-title">1. Which scent atmosphere do you naturally gravitiate towards?</h2>
            <p class="quiz-question-sub">Select the primary profile that matches your taste:</p>

            <div class="quiz-options-grid">
                <label class="quiz-option-card">
                    <input type="radio" name="vibe" value="oud" checked />
                    <div class="option-inner">
                        <span class="option-icon">👑</span>
                        <h3>Rich & Regal Oud</h3>
                        <p>Smoky woods, deep resinous amber, authentic oriental heritage.</p>
                    </div>
                </label>

                <label class="quiz-option-card">
                    <input type="radio" name="vibe" value="fresh" />
                    <div class="option-inner">
                        <span class="option-icon">🌊</span>
                        <h3>Crisp & Aquatic Fresh</h3>
                        <p>Cool ocean breeze, energetic citrus, clean linen feels.</p>
                    </div>
                </label>

                <label class="quiz-option-card">
                    <input type="radio" name="vibe" value="floral" />
                    <div class="option-inner">
                        <span class="option-icon">🌹</span>
                        <h3>Graceful & Romantic Floral</h3>
                        <p>Blooming Turkish rose, white jasmine petals, delicate sweetness.</p>
                    </div>
                </label>

                <label class="quiz-option-card">
                    <input type="radio" name="vibe" value="gourmand" />
                    <div class="option-inner">
                        <span class="option-icon">✨</span>
                        <h3>Warm & Sweet Gourmand</h3>
                        <p>Golden honey, creamy sandalwood, dark cocoa sweetness.</p>
                    </div>
                </label>
            </div>

            <div class="quiz-actions">
                <div></div>
                <button type="button" class="btn-gold" onclick="nextQuizStep(2)">NEXT STEP &rarr;</button>
            </div>
        </div>

        <!-- QUESTION STEP 2: PRIMARY OCCASION -->
        <div class="wizard-step-content" id="quizStep2" style="display: none;">
            <h2 class="quiz-question-title">2. When do you plan on wearing this fragrance most?</h2>
            <p class="quiz-question-sub">We tailor scent longevity and projection based on your routine:</p>

            <div class="quiz-options-grid">
                <label class="quiz-option-card">
                    <input type="radio" name="occasion" value="daily" checked />
                    <div class="option-inner">
                        <span class="option-icon">☀️</span>
                        <h3>Daily Wear & Office</h3>
                        <p>Subtle, clean, and refreshing scent profile for everyday confidence.</p>
                    </div>
                </label>

                <label class="quiz-option-card">
                    <input type="radio" name="occasion" value="evening" />
                    <div class="option-inner">
                        <span class="option-icon">🌙</span>
                        <h3>Evening & Special Events</h3>
                        <p>Deep, alluring projection meant to captivate special gatherings.</p>
                    </div>
                </label>

                <label class="quiz-option-card">
                    <input type="radio" name="occasion" value="spiritual" />
                    <div class="option-inner">
                        <span class="option-icon">🛕</span>
                        <h3>Spiritual & Peaceful Rituals</h3>
                        <p>Calming sandalwood, meditative saffron, and pure traditional notes.</p>
                    </div>
                </label>
            </div>

            <div class="quiz-actions">
                <button type="button" class="btn-outline" onclick="prevQuizStep(1)">&larr; BACK</button>
                <button type="button" class="btn-gold" onclick="nextQuizStep(3)">NEXT STEP &rarr;</button>
            </div>
        </div>

        <!-- QUESTION STEP 3: INTENSITY PREFERENCE -->
        <div class="wizard-step-content" id="quizStep3" style="display: none;">
            <h2 class="quiz-question-title">3. What is your desired scent intensity & projection?</h2>
            <p class="quiz-question-sub">Choose how close or bold you want your presence to feel:</p>

            <div class="quiz-options-grid">
                <label class="quiz-option-card">
                    <input type="radio" name="intensity" value="moderate" checked />
                    <div class="option-inner">
                        <span class="option-icon">🌿</span>
                        <h3>Subtle & Intimate</h3>
                        <p>Sits close to the skin. Personal aura that is noticed when near.</p>
                    </div>
                </label>

                <label class="quiz-option-card">
                    <input type="radio" name="intensity" value="strong" />
                    <div class="option-inner">
                        <span class="option-icon">🔥</span>
                        <h3>Bold & Long-Lasting</h3>
                        <p>Rich concentrated oil projection that leaves a memorable trail.</p>
                    </div>
                </label>
            </div>

            <div class="quiz-actions">
                <button type="button" class="btn-outline" onclick="prevQuizStep(2)">&larr; BACK</button>
                <button type="button" class="btn-gold" onclick="generateWizardResults()">DISCOVER MY SCENT ✨</button>
            </div>
        </div>

        <!-- RESULTS DISPLAY CONTAINER -->
        <div id="wizardResultsContainer" style="display: none;" class="wizard-results-box">
            <span class="results-tagline">YOUR MATCHED OLFACTORY RECOMMENDATIONS</span>
            <h2 class="results-title">Tailored Just For You</h2>
            <p class="results-subtitle">Based on your selections, here are the top artisanal attars from our collection:</p>

            <div class="product-grid" id="recommendedProductGrid" style="margin-top: 2rem;">
                <!-- DYNAMICALLY POPULATED VIA JS -->
            </div>

            <div style="text-align: center; margin-top: 2rem;">
                <button type="button" class="btn-outline" onclick="restartWizard()">↺ RETAKE FRAGRANCE QUIZ</button>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        let currentStep = 1;

        function nextQuizStep(step) {
            document.getElementById('quizStep' + currentStep).style.display = 'none';
            document.getElementById('quizStep' + step).style.display = 'block';

            document.getElementById('stepDot' + step).classList.add('active');
            if (step === 2) document.getElementById('stepLine1').classList.add('active');
            if (step === 3) document.getElementById('stepLine2').classList.add('active');

            currentStep = step;
        }

        function prevQuizStep(step) {
            document.getElementById('quizStep' + currentStep).style.display = 'none';
            document.getElementById('quizStep' + step).style.display = 'block';

            if (currentStep === 3) {
                document.getElementById('stepDot3').classList.remove('active');
                document.getElementById('stepLine2').classList.remove('active');
            } else if (currentStep === 2) {
                document.getElementById('stepDot2').classList.remove('active');
                document.getElementById('stepLine1').classList.remove('active');
            }

            currentStep = step;
        }

        function generateWizardResults() {
            const selectedVibe = document.querySelector('input[name="vibe"]:checked').value;

            // Hide step 3 content and step indicators
            document.getElementById('quizStep3').style.display = 'none';
            document.querySelector('.wizard-steps-indicator').style.display = 'none';

            // Recommendation mapping based on selected vibe
            const recommendations = {
                oud: [
                    { name: 'Kesar Chandan', family: 'Saffron • Sandalwood • Warm', price: '₹240.00 – ₹450.00', img: '/images/products/Kesar Chandan.jpeg' },
                    { name: 'Black Oud', family: 'Oud • Woody • Dark', price: '₹600.00 – ₹1,100.00', img: '/images/products/Black Oud.jpeg' }
                ],
                fresh: [
                    { name: 'Cool Water', family: 'Fresh • Aquatic', price: '₹150.00 – ₹250.00', img: '/images/products/Cool Water.jpeg' },
                    { name: 'Midnight Ice', family: 'Cool • Aromatic • Fresh', price: '₹150.00 – ₹260.00', img: '/images/products/Midnight Ice.jpeg' }
                ],
                floral: [
                    { name: 'Turkish Rose', family: 'Rose • Floral • Fresh', price: '₹390.00 – ₹750.00', img: '/images/products/Turkish Rose.jpeg' },
                    { name: 'Jasmine', family: 'White Floral • Jasmine • Fresh', price: '₹135.00 – ₹225.00', img: '/images/products/Jasmine.jpeg' }
                ],
                gourmand: [
                    { name: 'Honey Ember', family: 'Sweet • Warm • Amber', price: '₹150.00 – ₹260.00', img: '/images/products/Honey Ember.jpeg' },
                    { name: 'Cairo Evening', family: 'Oriental • Woody • Warm', price: '₹135.00 – ₹225.00', img: '/images/products/Cairo Evening.jpeg' }
                ]
            };

            const items = recommendations[selectedVibe] || recommendations['oud'];
            const grid = document.getElementById('recommendedProductGrid');
            grid.innerHTML = '';

            items.forEach(prod => {
                grid.innerHTML += `
                            <div class="product-card">
                                <img src="${prod.img}" alt="${prod.name}" onerror="this.src='https://via.placeholder.com/300x220?text=${encodeURIComponent(prod.name)}'" />
                                <h3>${prod.name}</h3>
                                <span class="scent-tag">${prod.family}</span>
                                <div class="product-price">${prod.price}</div>
                                <a href="/Home/Catalog?highlight=${encodeURIComponent(prod.name)}" class="btn-gold">VIEW IN CATALOG</a>
                            </div>
                        `;
            });

            document.getElementById('wizardResultsContainer').style.display = 'block';
        }

        function restartWizard() {
            document.getElementById('wizardResultsContainer').style.display = 'none';
            document.querySelector('.wizard-steps-indicator').style.display = 'flex';

            // Reset indicators
            document.getElementById('stepDot2').classList.remove('active');
            document.getElementById('stepDot3').classList.remove('active');
            document.getElementById('stepLine1').classList.remove('active');
            document.getElementById('stepLine2').classList.remove('active');

            currentStep = 1;
            document.getElementById('quizStep1').style.display = 'block';
        }
    </script>
}