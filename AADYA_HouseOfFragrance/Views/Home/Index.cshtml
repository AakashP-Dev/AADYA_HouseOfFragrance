﻿@{
ViewData["Title"] = "Home - Pure Luxury Timeless";
}

<!-- ============================================================ -->
<!-- 1. HERO BANNER                                               -->
<!-- ============================================================ -->
<section class="hero-banner">
    <div class="hero-content">
        <h1 class="hero-title">
            <span>PURE</span>
            <span class="hero-dot">•</span>
            <span>LUXURY</span>
            <span class="hero-dot">•</span>
            <span>TIMELESS</span>
        </h1>
        <p class="hero-subtitle">Crafted with Intention</p>
        <a asp-controller="Home" asp-action="Catalog" class="btn-gold hero-btn">EXPLORE COLLECTION</a>
    </div>
</section>

<!-- ============================================================ -->
<!-- 2. RECOMMENDED FOR YOU - CAROUSEL                            -->
<!-- ============================================================ -->
<section class="section-padding" style="padding-top: 1rem;">
    <div class="section-header">
        <h2 class="section-title" id="recTitle">Recommended For You</h2>
        <p class="section-subtitle" id="recSubtitle">Based on your preferences and trends</p>
    </div>

    <div class="carousel-container">
        <button class="carousel-arrow carousel-arrow-left" id="carouselPrev" aria-label="Previous">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>

        <div class="carousel-track-wrapper">
            <div class="carousel-track" id="recommendedTrack">
                <!-- Cards will be injected here by JavaScript -->
            </div>
        </div>

        <button class="carousel-arrow carousel-arrow-right" id="carouselNext" aria-label="Next">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>
    </div>

    <!-- Dot indicators -->
    <div class="carousel-dots" id="carouselDots"></div>
</section>

<!-- ============================================================ -->
<!-- 3. FEATURED COLLECTION (static)                              -->
<!-- ============================================================ -->
<section class="section-padding">
    <div class="section-header">
        <h2 class="section-title">FEATURED COLLECTION</h2>
        <p class="section-subtitle">Showcase best-selling or signature attars</p>
    </div>

    <div class="product-grid">
        <!-- Card 1 -->
        <div class="product-card">
            <img src="~/images/products/Kesar Chandan.jpeg" alt="Kesar Chandan" onerror="this.src='https://via.placeholder.com/300x220?text=Kesar+Chandan'" />
            <h3><a href="/Home/Catalog?highlight=Kesar%20Chandan">Kesar Chandan</a></h3>
            <span class="scent-tag">Saffron • Sandalwood • Warm</span>
            <div class="product-price">₹240.00 – ₹450.00</div>
            <a href="/Home/Catalog?highlight=Kesar%20Chandan" class="btn-gold">VIEW DETAILS</a>
        </div>

        <!-- Card 2 -->
        <div class="product-card">
            <img src="~/images/products/Black OUD.jpeg" alt="Black OUD" onerror="this.src='https://via.placeholder.com/300x220?text=Black+Oud'" />
            <h3><a href="/Home/Catalog?highlight=Black%20Oud">Black OUD</a></h3>
            <span class="scent-tag">Oud • Woody • Dark</span>
            <div class="product-price">₹600.00 – ₹1,100.00</div>
            <a href="/Home/Catalog?highlight=Black%20Oud" class="btn-gold">VIEW DETAILS</a>
        </div>

        <!-- Card 3 -->
        <div class="product-card">
            <img src="~/images/products/Cairo Evening.jpeg" alt="Cairo Evening" onerror="this.src='https://via.placeholder.com/300x220?text=Cairo+Evening'" />
            <h3><a href="/Home/Catalog?highlight=Cairo%20Evening">Cairo Evening</a></h3>
            <span class="scent-tag">Oriental • Woody • Warm</span>
            <div class="product-price">₹135.00 – ₹225.00</div>
            <a href="/Home/Catalog?highlight=Cairo%20Evening" class="btn-gold">VIEW DETAILS</a>
        </div>

        <!-- Card 4 -->
        <div class="product-card">
            <img src="~/images/products/Turkish Rose.jpeg" alt="Turkish Rose" onerror="this.src='https://via.placeholder.com/300x220?text=Turkish+Rose'" />
            <h3><a href="/Home/Catalog?highlight=Turkish%20Rose">Turkish Rose</a></h3>
            <span class="scent-tag">Rose • Floral • Fresh</span>
            <div class="product-price">₹390.00 – ₹750.00</div>
            <a href="/Home/Catalog?highlight=Turkish%20Rose" class="btn-gold">VIEW DETAILS</a>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- 4. OUR ESSENCE                                               -->
<!-- ============================================================ -->
<section class="essence-section" id="essence">
    <div class="essence-container">
        <h2 class="section-title">OUR ESSENCE</h2>

        <div class="essence-grid">
            <div class="essence-card">
                <div class="essence-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 21h18M3 10h18M5 10v11M9 10v11M15 10v11M19 10v11M12 3L2 10h20L12 3z" />
                    </svg>
                </div>
                <h3>HERITAGE</h3>
                <p>Rooted in ancient Indian scent traditions, celebrating time-honored distillation and authentic oriental botanicals.</p>
            </div>

            <div class="essence-card">
                <div class="essence-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 2v5.586a1 1 0 0 1-.293.707l-6.414 6.414A3 3 0 0 0 5.414 20h13.172a3 3 0 0 0 2.121-5.121l-6.414-6.414A1 1 0 0 1 14 7.586V2" />
                        <path d="M8.5 2h7M14 14.5a2 2 0 1 1-4 0" />
                    </svg>
                </div>
                <h3>CRAFTSMANSHIP</h3>
                <p>Every creation is a labor of love, blending pure botanical oils and rare woods with precision and care.</p>
            </div>

            <div class="essence-card">
                <div class="essence-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
                    </svg>
                </div>
                <h3>PURITY</h3>
                <p>100% alcohol-free concentrated attars and pure formulations designed to feel gentle, deep, and long-lasting.</p>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- 5. ABOUT AADYA                                              -->
<!-- ============================================================ -->
<section class="section-padding" id="about">
    <div class="about-grid">
        <div class="about-image-box">
            <img src="~/images/template.png" alt="AADYA Artisanal Craft" onerror="this.src='/images/Shelf-View-Banner.jpeg'" />
        </div>

        <div class="about-text-box">
            <span class="about-tagline">OUR STORY</span>
            <h2 class="about-title">The House of Fragrance</h2>
            <p>Born from a passion for purity and timeless luxury, AADYA began as a vision to craft fragrances that speak the language of human emotions.</p>
            <p>More than just a scent, AADYA is a personal experience that stays with you — elegant, subtle, and deeply memorable in every drop.</p>
            <a asp-controller="Home" asp-action="Wizard" class="btn-outline about-btn">DISCOVER YOUR SCENT &rarr;</a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // ================================================================
        // HOME PAGE – RECOMMENDATIONS CAROUSEL
        // ================================================================

        let recProducts = [];
        let currentSlide = 0;
        let itemsPerView = 4;
        let autoSlideInterval = null;

        const TRACK = document.getElementById('recommendedTrack');
        const PREV_BTN = document.getElementById('carouselPrev');
        const NEXT_BTN = document.getElementById('carouselNext');
        const DOTS_CONTAINER = document.getElementById('carouselDots');
        const CLONE_COUNT = 4; // Number of clones for seamless looping

                // ---- GET ITEMS PER VIEW BASED ON SCREEN WIDTH ----
                /**
                 * Determines how many product cards should be visible at once based on window width.
                 * @@returns { number } Number of items per view(1–4).
                 */
        function getItemsPerView() {
            const w = window.innerWidth;
            if (w >= 1024) return 4;
            if (w >= 768) return 3;
            if (w >= 480) return 2;
            return 1;
        }

        // ---- UPDATE ARROWS & DOTS VISIBILITY ----
        /**
         * Hides arrows and dots if the number of products is less than or equal to items per view.
         */
        function updateArrowsAndDotsVisibility() {
            const totalProducts = recProducts.length;
            const hide = totalProducts <= itemsPerView;
            PREV_BTN.style.display = hide ? 'none' : 'flex';
            NEXT_BTN.style.display = hide ? 'none' : 'flex';
            DOTS_CONTAINER.style.display = hide ? 'none' : 'flex';
        }

                // ---- CREATE PRODUCT CARD ----
                /**
                 * Creates a product card DOM element for the carousel.
                 * @@param { Object } product - The product data.
                 * @@returns { HTMLElement } The card element.
                 */
        function createProductCard(product) {
            const prices = product.variants.map(v => v.price);
            const minPrice = Math.min(...prices);
            const maxPrice = Math.max(...prices);
            const priceDisplay = minPrice === maxPrice ? `₹${minPrice}.00` : `₹${minPrice}.00 – ₹${maxPrice}.00`;
            const imgSrc = product.imageUrl || 'https://via.placeholder.com/300x220?text=' + encodeURIComponent(product.name);

            const card = document.createElement('div');
            card.className = 'product-card';
            card.dataset.productId = product.productId;
            card.innerHTML = `
                        <img src="${imgSrc}" alt="${product.name}" onerror="this.src='https://via.placeholder.com/300x220?text=${encodeURIComponent(product.name)}'" />
                        <h3><a href="/Home/Catalog?highlight=${encodeURIComponent(product.name)}">${product.name}</a></h3>
                        <span class="scent-tag">${product.scentFamily || 'Fragrance'}</span>
                        <div class="product-price">${priceDisplay}</div>
                        <a href="/Home/Catalog?highlight=${encodeURIComponent(product.name)}" class="btn-gold" style="font-size:0.7rem;">VIEW DETAILS</a>
                    `;
            return card;
        }

                // ---- RENDER CAROUSEL ----
                /**
                 * Renders the carousel with the given products and sets up the carousel state.
                 * @@param { Array } products - The list of products to display.
                 */
        function renderCarousel(products) {
            recProducts = products;
            const track = TRACK;
            track.innerHTML = '';

            if (!products || products.length === 0) {
                track.innerHTML = '<div style="flex:1; text-align:center; padding:2rem; color:var(--text-muted);">No recommendations available.</div>';
                DOTS_CONTAINER.innerHTML = '';
                PREV_BTN.style.display = 'none';
                NEXT_BTN.style.display = 'none';
                DOTS_CONTAINER.style.display = 'none';
                return;
            }

            products.forEach(product => {
                const card = createProductCard(product);
                track.appendChild(card);
            });

            // Clone first few items for infinite effect (only if more than itemsPerView)
            if (products.length > itemsPerView) {
                for (let i = 0; i < Math.min(CLONE_COUNT, products.length); i++) {
                    const clone = createProductCard(products[i]);
                    clone.classList.add('clone');
                    track.appendChild(clone);
                }
            }

            itemsPerView = getItemsPerView();
            currentSlide = 0;
            updateCarousel(false);
            buildDots();
            updateArrowsAndDotsVisibility();
            startAutoSlide();
        }

        // ---- BUILD DOTS ----
        /**
         * Creates dot indicators for the carousel based on the number of slides.
         */
        function buildDots() {
            const totalSlides = Math.ceil(recProducts.length / itemsPerView);
            DOTS_CONTAINER.innerHTML = '';
            if (totalSlides <= 1) {
                DOTS_CONTAINER.style.display = 'none';
                return;
            }
            DOTS_CONTAINER.style.display = 'flex';
            for (let i = 0; i < totalSlides; i++) {
                const dot = document.createElement('button');
                dot.className = 'carousel-dot' + (i === 0 ? ' active' : '');
                dot.dataset.index = i;
                dot.addEventListener('click', () => goToSlide(i));
                DOTS_CONTAINER.appendChild(dot);
            }
            updateArrowsAndDotsVisibility();
        }

                // ---- UPDATE CAROUSEL ----
                /**
                 * Updates the carousel transform and active dot based on the current slide.
                 * @@param { boolean } animate - Whether to animate the transition.
                 */
        function updateCarousel(animate = true) {
            const track = TRACK;
            const firstCard = track.querySelector('.product-card');
            if (!firstCard) return;

            const cardWidth = firstCard.offsetWidth;
            const gap = 1.2 * 16; // 1.2rem in pixels
            const slideWidth = cardWidth + gap;
            const offset = currentSlide * slideWidth;

            track.style.transition = animate ? 'transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94)' : 'none';
            track.style.transform = `translateX(-${offset}px)`;

            const realSlideCount = Math.ceil(recProducts.length / itemsPerView);
            const dotIndex = currentSlide % realSlideCount;
            document.querySelectorAll('.carousel-dot').forEach((dot, idx) => {
                dot.classList.toggle('active', idx === dotIndex);
            });

            // Seamless loop (only if more than one slide)
            const maxSlide = recProducts.length;
            if (currentSlide >= maxSlide && recProducts.length > itemsPerView) {
                setTimeout(() => {
                    const newIndex = currentSlide - maxSlide;
                    track.style.transition = 'none';
                    currentSlide = newIndex;
                    const newOffset = currentSlide * slideWidth;
                    track.style.transform = `translateX(-${newOffset}px)`;
                    void track.offsetHeight; // Force reflow
                    track.style.transition = 'transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
                }, 400);
            }
        }

                // ---- GO TO SLIDE ----
                /**
                 * Moves the carousel to a specific slide index.
                 * @@param { number } index - The slide index(0 - based).
                 */
        function goToSlide(index) {
            const totalItems = recProducts.length;
            if (totalItems <= itemsPerView) return;
            const maxSlide = totalItems;
            if (index < 0) index = 0;
            if (index > maxSlide) index = maxSlide;
            currentSlide = index;
            updateCarousel(true);
            resetAutoSlide();
        }

        // ---- NEXT SLIDE ----
        function nextSlide() {
            const totalItems = recProducts.length;
            if (totalItems <= itemsPerView) return;
            const maxSlide = totalItems + Math.min(CLONE_COUNT, totalItems) - itemsPerView + 1;
            if (currentSlide < maxSlide) {
                goToSlide(currentSlide + 1);
            } else {
                goToSlide(0);
            }
        }

        // ---- PREV SLIDE ----
        function prevSlide() {
            const totalItems = recProducts.length;
            if (totalItems <= itemsPerView) return;
            if (currentSlide > 0) {
                goToSlide(currentSlide - 1);
            } else {
                const maxSlide = totalItems + Math.min(CLONE_COUNT, totalItems) - itemsPerView + 1;
                goToSlide(maxSlide);
            }
        }

        // ---- AUTO SLIDE ----
        function startAutoSlide() {
            if (autoSlideInterval) clearInterval(autoSlideInterval);
            if (recProducts.length <= itemsPerView) return;
            autoSlideInterval = setInterval(nextSlide, 4000);
        }

        function resetAutoSlide() {
            if (autoSlideInterval) {
                clearInterval(autoSlideInterval);
                startAutoSlide();
            }
        }

        // ---- EVENT LISTENERS ----
        PREV_BTN.addEventListener('click', prevSlide);
        NEXT_BTN.addEventListener('click', nextSlide);

        const container = document.querySelector('.carousel-container');
        container.addEventListener('mouseenter', () => {
            if (autoSlideInterval) clearInterval(autoSlideInterval);
        });
        container.addEventListener('mouseleave', startAutoSlide);

        let resizeTimeout;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                const newItems = getItemsPerView();
                if (newItems !== itemsPerView) {
                    itemsPerView = newItems;
                    buildDots();
                    currentSlide = 0;
                    updateCarousel(false);
                    updateArrowsAndDotsVisibility();
                    resetAutoSlide();
                } else {
                    updateCarousel(false);
                }
            }, 200);
        });

        // ---- LOAD RECOMMENDATIONS ----
        /**
         * Fetches personalized recommendations from the API and renders the carousel.
         * Updates the title and subtitle based on login status and trigger product.
         */
        async function loadRecommendations() {
            const title = document.getElementById('recTitle');
            const subtitle = document.getElementById('recSubtitle');

            try {
                const token = localStorage.getItem('token');
                const headers = token ? { 'Authorization': 'Bearer ' + token } : {};

                const response = await fetch('/api/products/recommend/me', {
                    headers: headers
                });

                if (!response.ok) throw new Error('Failed to load recommendations');
                const data = await response.json();
                const products = data.recommendations || [];
                const triggerName = data.triggerProductName || '';

                if (!products || products.length === 0) {
                    TRACK.innerHTML = `
                                <div style="flex:1; text-align:center; padding:2rem; color:var(--text-muted);">
                                    No recommendations available. Start shopping to get personalized picks!
                                </div>
                            `;
                    DOTS_CONTAINER.innerHTML = '';
                    PREV_BTN.style.display = 'none';
                    NEXT_BTN.style.display = 'none';
                    DOTS_CONTAINER.style.display = 'none';
                    return;
                }

                // Update title based on login status and trigger product
                if (token && triggerName) {
                    title.textContent = `Because you liked “${triggerName}”…`;
                    subtitle.textContent = 'We picked these based on your scent preferences.';
                } else if (token && !triggerName) {
                    title.textContent = 'Recommended For You';
                    subtitle.textContent = 'Based on your preferences and trends';
                } else {
                    title.textContent = 'Trending Now';
                    subtitle.textContent = 'Most popular fragrances among our customers';
                }

                renderCarousel(products);

            } catch (error) {
                console.error('Failed to load recommendations:', error);
                TRACK.innerHTML = `
                            <div style="flex:1; text-align:center; padding:2rem; color:var(--text-muted);">
                                Could not load recommendations. Please try again later.
                            </div>
                        `;
                DOTS_CONTAINER.innerHTML = '';
                PREV_BTN.style.display = 'none';
                NEXT_BTN.style.display = 'none';
                DOTS_CONTAINER.style.display = 'none';
            }
        }

        // ---- INIT ----
        document.addEventListener('DOMContentLoaded', loadRecommendations);
    </script>
}