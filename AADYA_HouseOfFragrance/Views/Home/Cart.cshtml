@{
    ViewData["Title"] = "Shopping Cart - AADYA: The House of Fragrance";
}

<section class="section-padding" style="padding-top: 2rem; min-height: 70vh;">
    <div class="cart-header">
        <h1 class="cart-title">Your Olfactory Cart</h1>
        <p class="cart-subtitle">Review your selected concentrated attars and artisanal blends before checkout.</p>
    </div>

    <div class="cart-grid">
        <!-- ITEM LIST CONTAINER -->
        <div class="cart-items-container">
            <div class="cart-table-header">
                <span>Product</span>
                <span>Size</span>
                <span>Price</span>
                <span>Quantity</span>
                <span>Total</span>
                <span>Action</span>
            </div>

            <!-- SAMPLE ITEM 1 -->
            <div class="cart-item-row">
                <div class="cart-product-info">
                    <img src="~/images/products/Kesar Chandan.jpeg" alt="Kesar Chandan" onerror="this.src='https://via.placeholder.com/80'" />
                    <div>
                        <h3>Kesar Chandan</h3>
                        <span class="scent-tag">Saffron • Sandalwood</span>
                    </div>
                </div>
                <div class="cart-size-badge">12ml</div>
                <div class="cart-unit-price">₹450.00</div>
                <div class="qty-selector">
                    <button type="button" class="qty-btn" onclick="updateCartQty('kesar12', -1)">&minus;</button>
                    <input type="text" id="qty-kesar12" value="1" readonly class="qty-input" />
                    <button type="button" class="qty-btn" onclick="updateCartQty('kesar12', 1)">&plus;</button>
                </div>
                <div class="cart-item-total" id="total-kesar12">₹450.00</div>
                <button type="button" class="cart-remove-btn" title="Remove item" onclick="removeCartItem(this)">&times;</button>
            </div>

            <!-- SAMPLE ITEM 2 -->
            <div class="cart-item-row">
                <div class="cart-product-info">
                    <img src="~/images/products/Oud Al Noor.jpeg" alt="Oud Al Noor" onerror="this.src='https://via.placeholder.com/80'" />
                    <div>
                        <h3>Oud Al Noor</h3>
                        <span class="scent-tag">Oud • Woody</span>
                    </div>
                </div>
                <div class="cart-size-badge">6ml</div>
                <div class="cart-unit-price">₹240.00</div>
                <div class="qty-selector">
                    <button type="button" class="qty-btn" onclick="updateCartQty('oud6', -1)">&minus;</button>
                    <input type="text" id="qty-oud6" value="2" readonly class="qty-input" />
                    <button type="button" class="qty-btn" onclick="updateCartQty('oud6', 1)">&plus;</button>
                </div>
                <div class="cart-item-total" id="total-oud6">₹480.00</div>
                <button type="button" class="cart-remove-btn" title="Remove item" onclick="removeCartItem(this)">&times;</button>
            </div>

            <div class="cart-actions-bar">
                <a asp-controller="Home" asp-action="Catalog" class="btn-outline">&larr; CONTINUE SHOPPING</a>
            </div>
        </div>

        <!-- ORDER SUMMARY SIDEBAR -->
        <div class="cart-summary-card">
            <h3 class="summary-title">Order Summary</h3>

            <div class="summary-row">
                <span>Subtotal</span>
                <span id="summarySubtotal">₹930.00</span>
            </div>
            <div class="summary-row">
                <span>Estimated GST (18%)</span>
                <span id="summaryGst">₹167.40</span>
            </div>
            <div class="summary-row">
                <span>Shipping</span>
                <span class="free-shipping">FREE (Prepaid)</span>
            </div>

            <div class="summary-divider"></div>

            <div class="summary-row summary-total-row">
                <span>Grand Total</span>
                <span id="summaryGrandTotal">₹1,097.40</span>
            </div>

            <button type="button" class="btn-gold checkout-btn" onclick="alert('Proceeding to Checkout...')">PROCEED TO CHECKOUT</button>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function updateCartQty(id, change) {
            const input = document.getElementById('qty-' + id);
            let val = parseInt(input.value) + change;
            if (val < 1) val = 1;
            input.value = val;
            recalculateCartTotals();
        }

        function removeCartItem(btn) {
            const row = btn.closest('.cart-item-row');
            row.remove();
            recalculateCartTotals();
        }

        function recalculateCartTotals() {
            // Static calculate logic for UI demonstration
            let sub = 0;
            document.querySelectorAll('.cart-item-row').forEach(row => {
                const priceText = row.querySelector('.cart-unit-price').innerText.replace('₹', '');
                const price = parseFloat(priceText);
                const qty = parseInt(row.querySelector('.qty-input').value);
                const itemTotal = price * qty;
                row.querySelector('.cart-item-total').innerText = '₹' + itemTotal.toFixed(2);
                sub += itemTotal;
            });

            const gst = sub * 0.18;
            const grand = sub + gst;

            document.getElementById('summarySubtotal').innerText = '₹' + sub.toFixed(2);
            document.getElementById('summaryGst').innerText = '₹' + gst.toFixed(2);
            document.getElementById('summaryGrandTotal').innerText = '₹' + grand.toFixed(2);
        }
    </script>
}