﻿@{
ViewData["Title"] = "Privacy Policy";
}

<!-- ============================================================ -->
<!-- PRIVACY POLICY PAGE                                          -->
<!-- ============================================================ -->
<section class="section-padding" style="padding-top: 2rem; min-height: 60vh;">
    <div style="max-width: 800px; margin: 0 auto;">

        <h1 style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 1rem 0;">@ViewData["Title"]</h1>

        <div style="background: #FAF6EF; border:1px solid var(--border-color); border-radius:4px; padding:2rem;">
            <p style="color:var(--text-dark); line-height:1.8; margin:0;">
                This page is used to detail your site's privacy policy. Please update this content
                with your organization's privacy practices, data collection policies, and user rights information.
            </p>
            <p style="color:var(--text-dark); line-height:1.8; margin-top:1rem;">
                <strong>For AADYA: The House of Fragrance</strong>, we are committed to protecting your privacy.
                This policy explains how we collect, use, and safeguard your personal information when you visit our website.
            </p>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-top:1.5rem; border-top:1px solid var(--border-color); padding-top:1rem;">
                <em>Last updated: August 2026</em>
            </p>
        </div>

    </div>
</section>