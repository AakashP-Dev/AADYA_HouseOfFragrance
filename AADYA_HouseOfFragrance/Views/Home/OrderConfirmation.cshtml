@{
    ViewData["Title"] = "Order Confirmation - AADYA";
    var orderId = ViewData["OrderId"];
    var total = ViewData["TotalAmount"];
}

<section class="section-padding" style="min-height: 70vh; text-align: center; padding-top: 3rem;">
    <div style="max-width: 600px; margin: 0 auto; background: #FAF6EF; border: 1px solid var(--border-color); border-radius: 8px; padding: 2rem;">
        <div style="font-size: 4rem; color: var(--champagne-gold); margin-bottom: 1rem;">✅</div>
        <h1 style="font-family: var(--font-heading); color: var(--deep-burgundy);">Order Placed!</h1>
        <p style="font-size: 1.1rem; color: var(--text-dark);">
            Your order <strong>#@orderId</strong> has been placed successfully.
        </p>
        <p style="color: var(--text-muted);">Total Amount: <strong>₹@total</strong></p>

        <div style="background: var(--warm-beige); padding: 1rem; border-radius: 4px; margin: 1.5rem 0; text-align: left;">
            <h4 style="margin: 0 0 0.5rem 0; font-family: var(--font-heading);">Payment Instructions</h4>
            <p style="margin: 0.5rem 0; font-size: 0.9rem;">
                Please make payment via <strong>UPI</strong> to:<br>
                <span style="font-size: 1.2rem;">aadya@upi</span> (or scan QR code below)
            </p>
            <p style="font-size: 0.85rem; color: #856404; background: #fff3cd; padding: 0.5rem; border-radius: 4px;">
                ⚠️ Order will be processed after payment confirmation.
            </p>
        </div>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/Home/Catalog" class="btn-gold">CONTINUE SHOPPING</a>
            <a href="/Account/Orders" class="btn-outline">VIEW MY ORDERS</a>
        </div>
    </div>
</section>