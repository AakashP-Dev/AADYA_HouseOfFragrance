﻿@using AADYA_HouseOfFragrance.Models.Entities
@model Order

@{
    ViewData["Title"] = "Order Confirmation - AADYA";
    var orderId = Model.OrderId.ToString("D4");
}

<section class="section-padding" style="padding-top: 2rem; min-height: 70vh;">
    <div style="max-width: 700px; margin: 0 auto;">

        <!-- ============================================================ -->
        <!-- SUCCESS HEADER                                               -->
        <!-- ============================================================ -->
        <div style="text-align:center; margin-bottom:2rem;">
            <div style="font-size:3rem; margin-bottom:0.5rem;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            </div>
            <h1 style="font-family:var(--font-heading); color:#2e7d32; margin:0;">Order Confirmed!</h1>
            <p style="color:var(--text-muted); margin:0.2rem 0 0 0;">Thank you for your purchase. Your order has been placed successfully.</p>
        </div>

        <!-- ============================================================ -->
        <!-- ORDER SUMMARY CARD                                           -->
        <!-- ============================================================ -->
        <div style="background: #FAF6EF; border:1px solid var(--border-color); border-radius:4px; padding:2rem;">

            <!-- Order ID & Status -->
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; border-bottom:1px solid var(--border-color); padding-bottom:1rem; margin-bottom:1rem;">
                <div>
                    <span style="color:var(--text-muted); font-size:0.8rem;">ORDER ID</span>
                    <h2 style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0; font-size:1.5rem;">#AAD-@orderId</h2>
                </div>
                <span class="status-pill status-processing" style="background:#2e7d32; color:white;">@Model.OrderStatus</span>
            </div>

            <!-- Order Items -->
            <div style="margin-bottom:1.5rem;">
                <h4 style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 0.5rem 0;">Items</h4>
                @foreach (var item in Model.OrderItems)
                {
                    <div style="display:flex; justify-content:space-between; align-items:center; padding:0.5rem 0; border-bottom:1px dashed var(--border-color);">
                        <div>
                            <span style="font-weight:500;">@item.ProductVariant?.Product?.Name</span>
                            <span style="color:var(--text-muted); font-size:0.8rem;">(@item.ProductVariant?.Size)</span>
                            <span style="color:var(--text-muted); font-size:0.8rem;">× @item.Quantity</span>
                        </div>
                        <span style="font-weight:600;">₹@((item.UnitPriceAtSale * item.Quantity).ToString("F2"))</span>
                    </div>
                }
            </div>

            <!-- Grand Total -->
            <div style="display:flex; justify-content:space-between; align-items:center; border-top:2px solid var(--border-color); padding-top:1rem;">
                <span style="font-size:1.1rem; font-weight:600;">Grand Total</span>
                <span style="font-size:1.3rem; font-weight:700; color:var(--deep-burgundy);">₹@Model.TotalAmount.ToString("F2")</span>
            </div>

            <!-- Shipping Address -->
            <div style="margin-top:1.5rem; padding-top:1rem; border-top:1px solid var(--border-color);">
                <h4 style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 0.3rem 0;">Shipping Address</h4>
                <p style="color:var(--text-dark); margin:0;">@Model.ShippingAddress</p>
            </div>

            <!-- Payment Method -->
            <div style="margin-top:0.5rem;">
                <h4 style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 0.3rem 0;">Payment Method</h4>
                <p style="color:var(--text-dark); margin:0;">@Model.PaymentMethod</p>
            </div>

            <!-- Action Buttons -->
            <div style="display:flex; gap:1rem; margin-top:2rem; flex-wrap:wrap; justify-content:center;">
                <a href="/Account/Orders" class="btn-gold" style="padding:0.7rem 2rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                        <rect x="2" y="3" width="20" height="18" rx="2" />
                        <line x1="8" y1="9" x2="16" y2="9" />
                        <line x1="8" y1="13" x2="16" y2="13" />
                        <line x1="8" y1="17" x2="12" y2="17" />
                    </svg>
                    VIEW MY ORDERS
                </a>
                <a href="/Home/Catalog" class="btn-outline" style="padding:0.7rem 2rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    CONTINUE SHOPPING
                </a>
            </div>

            <!-- Email Notice -->
            <p style="text-align:center; font-size:0.8rem; color:var(--text-muted); margin-top:1.5rem;">
                A confirmation email has been sent to your registered email address.
            </p>

        </div>
    </div>
</section>