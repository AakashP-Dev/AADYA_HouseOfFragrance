﻿@{
ViewData["Title"] = "All Fragrances - The Olfactory Collection";
}

<!-- ============================================================ -->
<!-- 1. CATALOG HERO BANNER                                        -->
<!-- ============================================================ -->
<section class="catalog-hero-banner">
    <div class="catalog-hero-content">
        <span class="catalog-tagline">PURE • LUXURY • TIMELESS</span>
        <h1 class="catalog-title">The Olfactory Collection</h1>
        <p class="catalog-subtitle">
            Explore our complete range of 100% alcohol-free concentrated attars and artisanal luxury blends.
        </p>
    </div>
</section>

<!-- ============================================================ -->
<!-- 2. MAIN CATALOG SECTION                                       -->
<!-- ============================================================ -->
<section class="section-padding" style="padding-top: 2rem;">

    <!-- Filter & Search Bar -->
    <div class="filter-bar-container">
        <div class="filter-pills" id="filterPills">
            <button class="filter-btn active" data-filter="all">All Scents</button>
            <button class="filter-btn" data-filter="oud">Oud & Heritage</button>
            <button class="filter-btn" data-filter="fresh">Aquatic & Fresh</button>
            <button class="filter-btn" data-filter="floral">Floral & Rose</button>
            <button class="filter-btn" data-filter="gourmand">Gourmand & Amber</button>
        </div>

        <div class="search-sort-inputs">
            <input type="text" id="searchInput" placeholder="Search fragrance..." class="custom-input" />
            <select id="sortSelect" class="custom-select">
                <option value="popular">Most Popular</option>
                <option value="low-high">Price: Low to High</option>
                <option value="high-low">Price: High to Low</option>
            </select>
        </div>
    </div>

    <!-- Product Count -->
    <div class="catalog-count-label" id="productCountLabel">Loading Fragrances...</div>

    <!-- Dynamic Product Grid -->
    <div class="product-grid" id="productGrid">
        <!-- Cards will be injected here by JavaScript -->
    </div>

    <!-- No Fragrances Found -->
    <div id="noResultsContainer" class="no-results-box" style="display: none;">
        <div class="no-results-icon">✨</div>
        <h3 class="no-results-title">No Fragrances Found</h3>
        <p class="no-results-text">We couldn't find any fragrances matching your current search or category filter.</p>
        <button class="btn-outline" onclick="resetCatalogFilters()">CLEAR ALL FILTERS</button>
    </div>
</section>

<!-- ============================================================ -->
<!-- 3. SLIDE-OVER QUICK VIEW DRAWER                              -->
<!-- ============================================================ -->
<div class="drawer-overlay" id="drawerOverlay" onclick="closeProductDrawer()"></div>
<div class="product-drawer" id="productDrawer">
    <button class="drawer-close-btn" onclick="closeProductDrawer()">&times;</button>
    <div class="drawer-content">
        <div class="drawer-img-container">
            <img id="drawerImage" src="" alt="Product Image" />
        </div>
        <div class="drawer-details">
            <span class="drawer-tagline">PURE CONCENTRATED ATTAR</span>
            <h2 class="drawer-title" id="drawerTitle">Product Name</h2>
            <div class="drawer-scent-tag" id="drawerScentTag">Scent Family</div>
            <p class="drawer-desc" id="drawerDesc">Fragrance description.</p>

            <!-- Dual Size Selection -->
            <div class="dual-size-section">
                <label class="size-section-label">Select Quantities for Desired Bottle Sizes:</label>
                <div id="variantSelectorContainer">
                    <!-- Variants will be injected here dynamically -->
                </div>
            </div>

            <!-- Total Price Display -->
            <div class="drawer-price-box">
                <span class="price-label">Total Amount:</span>
                <span class="price-value" id="drawerTotal">₹0.00</span>
            </div>

            <!-- Frequently Bought Together -->
            <div id="drawerFrequentlyBought" style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-color); display: none;">
                <p style="font-size: 0.8rem; font-weight: 600; color: var(--deep-burgundy); margin-bottom: 0.8rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <path d="M16 10a4 4 0 0 1-8 0" />
                    </svg>
                    Frequently Bought Together
                </p>
                <div id="drawerFreqBoughtLoading" style="text-align: center; padding: 0.5rem;">
                    <span style="font-size: 0.8rem; color: var(--text-muted);">Loading...</span>
                </div>
                <div id="drawerFreqBoughtContent" style="display: none; display: flex; gap: 0.8rem; flex-wrap: wrap;">
                    <!-- Related products will be injected here -->
                </div>
                <div id="drawerFreqBoughtEmpty" style="display: none; text-align: center; padding: 0.5rem;">
                    <span style="font-size: 0.8rem; color: var(--text-muted);">No recommendations available.</span>
                </div>
            </div>
        </div>
    </div>
    <button type="button" class="btn-gold drawer-add-btn" onclick="handleAddToCart()">ADD SELECTED TO CART</button>
</div>

<!-- ============================================================ -->
<!-- 4. STICKY 6ML TRACKER                                        -->
<!-- ============================================================ -->
<div id="sticky6mlTracker" style="display:none; position:fixed; bottom:0; left:0; right:0; background:var(--warm-ivory); border-top:2px solid var(--champagne-gold); padding:0.8rem 2rem; box-shadow:0 -4px 20px rgba(0,0,0,0.1); z-index:999; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); transform: translateY(100%);">
    <div style="max-width:1200px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.8rem;">
        <div style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
            <span style="font-weight:600; font-family:var(--font-heading); font-size:0.9rem;">Your 6ml Bottles:</span>
            <span id="trackerMessage" style="font-size:0.85rem; color:var(--text-muted);"></span>
        </div>
        <div id="trackerItemList" style="display:flex; flex-wrap:wrap; gap:0.6rem; align-items:center; flex:1; justify-content:flex-start;"></div>
        <a href="/Home/Cart" class="btn-gold" style="font-size:0.75rem; padding:0.4rem 1.2rem; white-space:nowrap;">VIEW CART</a>
    </div>
</div>

<!-- ============================================================ -->
<!-- REMOVE CONFIRMATION MODAL                                    -->
<!-- ============================================================ -->
<div id="removeModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9998; align-items:center; justify-content:center;">
    <div style="background:white; padding:2rem; border-radius:8px; max-width:400px; text-align:center; box-shadow:0 4px 20px rgba(0,0,0,0.3);">
        <h3 style="font-family:var(--font-heading); color:var(--deep-burgundy);">Remove Item</h3>
        <p id="removeModalMessage" style="color:var(--text-muted); margin:1rem 0;">Are you sure you want to remove this item from your cart?</p>
        <div style="display:flex; gap:1rem; justify-content:center; margin-top:1.5rem;">
            <button id="removeConfirmYes" class="btn-gold">Yes, Remove</button>
            <button id="removeConfirmNo" class="btn-outline">Cancel</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ================================================================
        // CATALOG PAGE – LOAD, FILTER, SORT, DRAWER, CART
        // ================================================================

        // ---- GLOBAL STATE ----
        let allProducts = [];
        let activeFilter = 'all';
        let currentDrawerVariants = [];
        let removeItemCallback = null;

        // ---- 1. FETCH PRODUCTS ----
        /**
         * Fetches all products from the API and renders the catalog.
         * Handles API errors with fallback data.
         */
        async function loadProducts() {
            const grid = document.getElementById('productGrid');
            const countLabel = document.getElementById('productCountLabel');
            grid.innerHTML = '';
            countLabel.innerText = 'Loading Fragrances...';

            try {
                const response = await fetch('/api/products');
                if (!response.ok) throw new Error('Network response was not ok');
                allProducts = await response.json();

                // Ensure variants exists on each product
                allProducts = allProducts.map(p => ({
                    ...p,
                    variants: p.variants || []
                }));

                renderCatalog(allProducts);
                updateStickyTracker();
                updateCartBadge();
            } catch (error) {
                console.error('Failed to load products:', error);
                allProducts = getFallbackProducts();
                renderCatalog(allProducts);
            }
        }

                // ---- 2. FILTER GROUP MAPPING ----
                /**
                 * Maps scent families to filter group names.
                 * @@param { Object } product - The product object.
                 * @@returns { string } The filter group('oud', 'fresh', 'floral', 'gourmand', 'all').
                 */
        function getFilterGroup(product) {
            const scent = (product.scentFamily || '').toLowerCase();
            switch (scent) {
                case 'woody': return 'oud';
                case 'fresh':
                case 'citrus': return 'fresh';
                case 'floral': return 'floral';
                case 'spicy': return 'gourmand';
                default: return 'all';
            }
        }

                // ---- 3. RENDER PRODUCT GRID ----
                /**
                 * Renders the product grid with cards.
                 * Shows "OUT OF STOCK" badge and disables button if stock is 0.
                 * @@param { Array } products - The list of products to render.
                 */
        function renderCatalog(products) {
            const grid = document.getElementById('productGrid');
            const countLabel = document.getElementById('productCountLabel');

            if (!products || products.length === 0) {
                grid.style.display = 'none';
                document.getElementById('noResultsContainer').style.display = 'block';
                countLabel.innerText = 'Showing 0 Fragrances';
                return;
            }

            grid.style.display = 'grid';
            document.getElementById('noResultsContainer').style.display = 'none';
            countLabel.innerText = `Showing ${products.length} Fragrance${products.length === 1 ? '' : 's'}`;

            grid.innerHTML = '';
            products.forEach(product => {
                const variants = product.variants || [];

                const prices = variants.map(v => v.price || 0);
                const minPrice = prices.length ? Math.min(...prices) : 0;
                const maxPrice = prices.length ? Math.max(...prices) : 0;
                const priceDisplay = minPrice === maxPrice ? `₹${minPrice}.00` : `₹${minPrice}.00 – ₹${maxPrice}.00`;
                const imgSrc = product.imageUrl || 'https://via.placeholder.com/300x220?text=' + encodeURIComponent(product.name);
                const avgPrice = prices.length ? prices.reduce((a, b) => a + b, 0) / prices.length : 0;

                const totalStock = variants.reduce((sum, v) => sum + (v.stockQuantity || 0), 0);
                const isOutOfStock = totalStock === 0;

                const card = document.createElement('div');
                card.className = 'product-card';
                card.style.position = 'relative';
                card.dataset.name = product.name;
                card.dataset.category = getFilterGroup(product);
                card.dataset.productId = product.productId;
                card.dataset.price = Math.round(avgPrice);
                card.dataset.bought = product.totalSold || 0;

                card.innerHTML = `
                            <img src="${imgSrc}" alt="${product.name}" onerror="this.src='https://via.placeholder.com/300x220?text=${encodeURIComponent(product.name)}'" />
                            ${isOutOfStock ? '<span style="position:absolute; top:10px; right:10px; background:#d32f2f; color:white; padding:0.2rem 0.8rem; border-radius:20px; font-size:0.7rem; font-weight:600; z-index:2;">OUT OF STOCK</span>' : ''}
                            <h3>${product.name}</h3>
                            <span class="scent-tag">${product.scentFamily || 'Fragrance'}</span>
                            <div class="product-price">${priceDisplay}</div>
                            <button class="btn-gold quick-view-btn" onclick="openProductDrawer(${product.productId})" ${isOutOfStock ? 'disabled style="opacity:0.5; cursor:not-allowed;"' : ''}>
                                ${isOutOfStock ? 'OUT OF STOCK' : 'VIEW DETAILS'}
                            </button>
                        `;
                grid.appendChild(card);
            });

            applyFiltersAndSort();
        }

        // ---- 4. FILTER, SORT, SEARCH ----
        /**
         * Applies active filters, search query, and sorting to the product grid.
         */
        function applyFiltersAndSort() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const sortVal = document.getElementById('sortSelect').value;
            const cards = Array.from(document.getElementById('productGrid').children);

            let visibleCount = 0;
            cards.forEach(card => {
                const name = card.dataset.name.toLowerCase();
                const category = card.dataset.category;
                const matchesFilter = (activeFilter === 'all' || category === activeFilter);
                const matchesSearch = name.includes(query);

                if (matchesFilter && matchesSearch) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            document.getElementById('productCountLabel').innerText = `Showing ${visibleCount} Fragrance${visibleCount === 1 ? '' : 's'}`;
            document.getElementById('noResultsContainer').style.display = visibleCount === 0 ? 'block' : 'none';
            document.getElementById('productGrid').style.display = visibleCount === 0 ? 'none' : 'grid';

            const visibleCards = cards.filter(c => c.style.display !== 'none');
            visibleCards.sort((a, b) => {
                const priceA = parseInt(a.dataset.price) || 0;
                const priceB = parseInt(b.dataset.price) || 0;
                const boughtA = parseInt(a.dataset.bought) || 0;
                const boughtB = parseInt(b.dataset.bought) || 0;

                if (sortVal === 'popular') return boughtB - boughtA;
                if (sortVal === 'low-high') return priceA - priceB;
                if (sortVal === 'high-low') return priceB - priceA;
                return 0;
            });
            visibleCards.forEach(card => document.getElementById('productGrid').appendChild(card));
        }

                // ---- 5. DRAWER FUNCTIONS ----
                /**
                 * Opens the quick view drawer for a product.
                 * Loads variants, stock info, and frequently bought items.
                 * @@param { number } productId - The ID of the product to display.
                 */
        async function openProductDrawer(productId) {
            const product = allProducts.find(p => p.productId === productId);
            if (!product) return;

            currentDrawerVariants = product.variants || [];

            // Check total stock for the product
            const totalStock = currentDrawerVariants.reduce((sum, v) => sum + (v.stockQuantity || 0), 0);
            const isOutOfStock = totalStock === 0;

            document.getElementById('drawerTitle').innerText = product.name;
            document.getElementById('drawerScentTag').innerText = product.scentFamily || 'Fragrance';
            document.getElementById('drawerDesc').innerText = product.description || 'A beautifully crafted artisanal attar.';
            document.getElementById('drawerImage').src = product.imageUrl || 'https://via.placeholder.com/300x220?text=' + encodeURIComponent(product.name);

            const container = document.getElementById('variantSelectorContainer');
            container.innerHTML = '';
            currentDrawerVariants.forEach((variant, index) => {
                const isVariantOutOfStock = (variant.stockQuantity || 0) === 0;

                const row = document.createElement('div');
                row.className = 'size-qty-row';
                row.dataset.variantId = variant.variantId;
                row.dataset.price = variant.price || 0;
                row.dataset.stock = variant.stockQuantity || 0;

                row.innerHTML = `
                            <div class="size-info">
                                <span class="size-title">${variant.size || 'N/A'} Bottle</span>
                                <span class="size-unit-price">₹${variant.price || 0}.00</span>
                                ${isVariantOutOfStock ? '<span style="color:#d32f2f; font-size:0.7rem; margin-left:0.5rem;">(Out of Stock)</span>' : ''}
                            </div>
                            <div class="qty-selector">
                                <button type="button" class="qty-btn" onclick="updateDrawerQty(${index}, -1)" ${isVariantOutOfStock ? 'disabled style="opacity:0.3; cursor:not-allowed;"' : ''}>&minus;</button>
                                <input type="text" id="drawerQty_${index}" value="${isVariantOutOfStock ? 0 : (index === 0 ? 0 : 1)}" readonly class="qty-input" />
                                <button type="button" class="qty-btn" onclick="updateDrawerQty(${index}, 1)" ${isVariantOutOfStock ? 'disabled style="opacity:0.3; cursor:not-allowed;"' : ''}>&plus;</button>
                            </div>
                        `;
                container.appendChild(row);
            });

            recalculateDrawerTotal();
            document.getElementById('drawerOverlay').classList.add('open');
            document.getElementById('productDrawer').classList.add('open');
            document.body.style.overflow = 'hidden';

            // Load frequently bought items
            const firstVariant = currentDrawerVariants[0];
            if (firstVariant) {
                await loadFrequentlyBoughtInDrawer(firstVariant.variantId);
            }

            // Disable ADD TO CART if out of stock
            const addBtn = document.querySelector('.drawer-add-btn');
            if (isOutOfStock) {
                addBtn.disabled = true;
                addBtn.style.opacity = '0.5';
                addBtn.style.cursor = 'not-allowed';
                addBtn.textContent = 'OUT OF STOCK';
            } else {
                addBtn.disabled = false;
                addBtn.style.opacity = '1';
                addBtn.style.cursor = 'pointer';
                addBtn.textContent = 'ADD SELECTED TO CART';
            }
        }

        /**
         * Closes the quick view drawer.
         */
        function closeProductDrawer() {
            document.getElementById('drawerOverlay').classList.remove('open');
            document.getElementById('productDrawer').classList.remove('open');
            document.body.style.overflow = 'auto';
        }

                /**
                 * Updates the quantity of a variant in the drawer.
                 * @@param { number } index - The index of the variant in the list.
                 * @@param { number } change - The amount to change by(+1 or - 1).
                 */
        function updateDrawerQty(index, change) {
            const input = document.getElementById('drawerQty_' + index);
            let val = parseInt(input.value) + change;
            const stock = parseInt(document.querySelector(`#variantSelectorContainer .size-qty-row:nth-child(${index + 1})`).dataset.stock) || 0;
            if (val < 0) val = 0;
            if (val > stock) {
                showToast('Not enough stock!', 'error');
                return;
            }
            input.value = val;
            recalculateDrawerTotal();
        }

        /**
         * Recalculates the total price based on selected quantities.
         */
        function recalculateDrawerTotal() {
            let total = 0;
            const rows = document.querySelectorAll('#variantSelectorContainer .size-qty-row');
            rows.forEach(row => {
                const price = parseFloat(row.dataset.price) || 0;
                const qty = parseInt(row.querySelector('.qty-input').value) || 0;
                total += price * qty;
            });
            document.getElementById('drawerTotal').innerText = '₹' + total.toLocaleString('en-IN') + '.00';
        }

        // ---- 6. ADD TO CART ----
        /**
         * Handles adding selected items to the cart.
         * Validates stock and sends individual API requests per variant.
         */
        async function handleAddToCart() {
            let items = [];
            const rows = document.querySelectorAll('#variantSelectorContainer .size-qty-row');
            let hasError = false;

            rows.forEach(row => {
                const qty = parseInt(row.querySelector('.qty-input').value) || 0;
                const stock = parseInt(row.dataset.stock) || 0;
                if (qty > stock) {
                    showToast(`Not enough stock! Available: ${stock}`, 'error');
                    hasError = true;
                }
                if (qty > 0) {
                    items.push({
                        variantId: parseInt(row.dataset.variantId),
                        quantity: qty
                    });
                }
            });

            if (hasError) return;
            if (items.length === 0) {
                showToast('Please select at least one bottle quantity.', 'error');
                return;
            }

            const token = localStorage.getItem('token');
            if (!token) {
                showToast('Please login to add items to cart.', 'error');
                return;
            }

            let addedCount = 0;
            let failedItems = [];

            const addPromises = items.map(item =>
                fetch('/api/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify(item)
                })
                    .then(res => {
                        if (res.ok) {
                            addedCount++;
                            return res.json();
                        } else {
                            return res.json().then(err => {
                                failedItems.push({ variantId: item.variantId, error: err.message || 'Unknown error' });
                            });
                        }
                    })
                    .catch(err => {
                        failedItems.push({ variantId: item.variantId, error: 'Network error' });
                    })
            );

            await Promise.all(addPromises);

            if (failedItems.length === 0) {
                showToast(`Successfully added ${addedCount} item(s) to cart!`, 'success');
                closeProductDrawer();
                updateCartBadge();
                updateStickyTracker();
            } else {
                showToast(`Added ${addedCount} item(s). Failed to add ${failedItems.length} item(s).`, 'error');
                console.error(failedItems);
            }
        }

                // ---- 7. FREQUENTLY BOUGHT ----
                /**
                 * Loads and displays frequently bought items in the drawer.
                 * @@param { number } variantId - The variant ID to find related items for.
                 */
                async function loadFrequentlyBoughtInDrawer(variantId) {
                const loading = document.getElementById('drawerFreqBoughtLoading');
                const content = document.getElementById('drawerFreqBoughtContent');
                const empty = document.getElementById('drawerFreqBoughtEmpty');
                const container = document.getElementById('drawerFrequentlyBought');

                container.style.display = 'block';
                loading.style.display = 'block';
                content.style.display = 'none';
                empty.style.display = 'none';

                try {
                    const response = await fetch(`/api/products/${variantId}/frequently-bought-with`);
                    if (!response.ok) throw new Error('Failed to fetch recommendations');
                    const recommendations = await response.json();

                    loading.style.display = 'none';

                    if (!recommendations || recommendations.length === 0) {
                        empty.style.display = 'block';
                        return;
                    }

                    content.style.display = 'flex';
                    content.innerHTML = '';

                    recommendations.slice(0, 3).forEach(rec => {
                        const imgSrc = rec.imageUrl || 'https://via.placeholder.com/60x60?text=' + encodeURIComponent(rec.name);
                        const prices = rec.variants?.map(v => v.price) || [];
                        const min = prices.length ? Math.min(...prices) : 0;
                        const priceDisplay = `₹${min}`;

                        const item = document.createElement('div');
                        item.style.cssText = 'display: flex; align-items: center; gap: 0.6rem; background: var(--warm-ivory); border: 1px solid var(--border-color); border-radius: 4px; padding: 0.4rem 0.8rem 0.4rem 0.4rem; flex: 1; min-width: 140px;';
                        item.innerHTML = `
                                <img src="${imgSrc}" alt="${rec.name}" style="width: 40px; height: 40px; object-fit: cover; border-radius: 3px; border: 1px solid var(--border-color);" onerror="this.src='https://via.placeholder.com/40x40?text=${encodeURIComponent(rec.name.charAt(0))}'" />
                                <div style="flex: 1;">
                                    <div style="font-size: 0.78rem; font-weight: 600; color: var(--deep-burgundy);">${rec.name}</div>
                                    <div style="font-size: 0.7rem; color: var(--text-muted);">${priceDisplay}</div>
                                </div>
                                <a href="/Home/Catalog?highlight=${encodeURIComponent(rec.name)}" style="font-size: 0.65rem; padding: 0.2rem 0.6rem; background: var(--deep-burgundy); color: var(--warm-ivory); border-radius: 2px; text-decoration: none; white-space: nowrap;">VIEW</a>
                            `;
                        content.appendChild(item);
                    });

                } catch (error) {
                    console.error('Error loading frequently bought:', error);
                    loading.style.display = 'none';
                    empty.style.display = 'block';
                    empty.innerHTML = '<span style="font-size: 0.8rem; color: var(--text-muted);">Could not load recommendations.</span>';
                }
            }

                // ---- 8. STICKY TRACKER ----
                /**
                 * Updates the sticky 6ml tracker at the bottom of the page.
                 * Shows 6ml items in the cart and their quantities.
                 */
                async function updateStickyTracker() {
                const token = localStorage.getItem('token');
                if (!token) {
                    document.getElementById('sticky6mlTracker').style.display = 'none';
                    return;
                }

                try {
                    const res = await fetch('/api/cart', {
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                    if (!res.ok) throw new Error('Failed to fetch cart');
                    const data = await res.json();
                    const items = data.items || [];

                    const sixMlItems = items.filter(item => item.size === '6ml');
                    const total6ml = sixMlItems.reduce((sum, item) => sum + item.quantity, 0);

                    const tracker = document.getElementById('sticky6mlTracker');
                    const listContainer = document.getElementById('trackerItemList');
                    const message = document.getElementById('trackerMessage');

                    if (total6ml === 0 || sixMlItems.length === 0) {
                        tracker.style.display = 'none';
                        tracker.style.transform = 'translateY(100%)';
                        return;
                    }

                    tracker.style.display = 'block';
                    setTimeout(() => {
                        tracker.style.transform = 'translateY(0)';
                    }, 50);

                    listContainer.innerHTML = '';
                    sixMlItems.forEach(item => {
                        const imgSrc = item.productImage || 'https://via.placeholder.com/32?text=' + (item.productName?.charAt(0) || '?');
                        const div = document.createElement('div');
                        div.style.cssText = `
                                background: var(--warm-beige);
                                border: 1px solid var(--border-color);
                                border-radius: 20px;
                                padding: 0.2rem 0.6rem 0.2rem 0.4rem;
                                display: inline-flex;
                                align-items: center;
                                gap: 0.4rem;
                                font-size: 0.8rem;
                                transition: all 0.2s ease;
                                white-space: nowrap;
                            `;
                        div.innerHTML = `
                                <img src="${imgSrc}" alt="${item.productName}" style="width:28px; height:28px; border-radius:50%; object-fit:cover; border:1px solid var(--border-color); background:white;" onerror="this.src='https://via.placeholder.com/28?text=${(item.productName?.charAt(0) || '?')}'" />
                                <span style="font-weight:500; font-size:0.8rem;">${item.productName}</span>
                                <span style="color:var(--text-muted); font-size:0.7rem;">×${item.quantity}</span>
                                <button onclick="confirmRemoveSixMlItem('${item.productName}', ${item.cartItemId})" style="background:none; border:none; color:#d32f2f; cursor:pointer; font-size:1rem; line-height:1; padding:0 2px; transition:transform 0.2s;" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'" title="Remove from cart">✕</button>
                            `;
                        listContainer.appendChild(div);
                    });

                    if (total6ml < 3) {
                        message.innerText = `Add ${3 - total6ml} more 6ml bottle(s) to place order.`;
                    } else {
                        message.innerText = '✅ You have enough 6ml bottles!';
                    }

                } catch (error) {
                    console.error('Failed to load cart for tracker:', error);
                }
            }

                /**
                 * Confirms removal of a 6ml item from the cart.
                 * @@param { string } itemName - The name of the item.
                 * @@param { number } cartItemId - The ID of the cart item.
                 */
        function confirmRemoveSixMlItem(itemName, cartItemId) {
            showRemoveModal(itemName, function () {
                removeSixMlItem(cartItemId);
            });
        }

                /**
                 * Removes a 6ml item from the cart via API.
                 * @@param { number } cartItemId - The ID of the cart item to remove.
                 */
        async function removeSixMlItem(cartItemId) {
            const token = localStorage.getItem('token');
            if (!token) {
                showToast('Please login to manage your cart.', 'error');
                return;
            }

            try {
                const res = await fetch(`/api/cart/remove/${cartItemId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (!res.ok) {
                    const err = await res.json();
                    showToast(err.message || 'Failed to remove item', 'error');
                    return;
                }
                updateStickyTracker();
                updateCartBadge();
                showToast('Item removed from cart.', 'success');
            } catch (error) {
                console.error('Error removing item:', error);
                showToast('Network error. Please try again.', 'error');
            }
        }

        // ---- 9. CART BADGE ----
        /**
         * Updates the cart badge in the navbar with the current item count.
         */
        async function updateCartBadge() {
            const token = localStorage.getItem('token');
            if (!token) {
                const badge = document.getElementById('cartCountBadge');
                if (badge) badge.innerText = '0';
                return;
            }
            try {
                const res = await fetch('/api/cart', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (!res.ok) throw new Error('Failed to fetch cart');
                const data = await res.json();
                const total = (data.items || []).reduce((s, i) => s + i.quantity, 0);
                const badge = document.getElementById('cartCountBadge');
                if (badge) badge.innerText = total;
            } catch (e) {
                console.error('Badge update error:', e);
            }
        }

                // ---- 10. REMOVE MODAL ----
                /**
                 * Opens the remove confirmation modal.
                 * @@param { string } itemName - The name of the item to remove.
                 * @@param { Function } callback - The function to call on confirmation.
                 */
        function showRemoveModal(itemName, callback) {
            document.getElementById('removeModalMessage').innerHTML =
                `Are you sure you want to remove <strong>${itemName}</strong> from your cart?`;
            removeItemCallback = callback;
            document.getElementById('removeModal').style.display = 'flex';
        }

        document.getElementById('removeConfirmYes').addEventListener('click', function () {
            document.getElementById('removeModal').style.display = 'none';
            if (removeItemCallback) {
                removeItemCallback();
                removeItemCallback = null;
            }
        });

        document.getElementById('removeConfirmNo').addEventListener('click', function () {
            document.getElementById('removeModal').style.display = 'none';
            removeItemCallback = null;
        });

        document.getElementById('removeModal').addEventListener('click', function (e) {
            if (e.target === this) {
                this.style.display = 'none';
                removeItemCallback = null;
            }
        });

        // ---- 11. EVENT LISTENERS ----
        document.getElementById('searchInput').addEventListener('input', applyFiltersAndSort);
        document.getElementById('sortSelect').addEventListener('change', applyFiltersAndSort);

        document.getElementById('filterPills').addEventListener('click', (e) => {
            if (e.target.classList.contains('filter-btn')) {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                e.target.classList.add('active');
                activeFilter = e.target.dataset.filter;
                applyFiltersAndSort();
            }
        });

        /**
         * Resets all catalog filters and sorting to default.
         */
        window.resetCatalogFilters = function () {
            document.getElementById('searchInput').value = '';
            document.getElementById('sortSelect').value = 'popular';
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            document.querySelector('.filter-btn[data-filter="all"]').classList.add('active');
            activeFilter = 'all';
            applyFiltersAndSort();
        };

                // ---- 12. FALLBACK PRODUCTS ----
                /**
                 * Returns fallback product data if the API fails.
                 * @@returns { Array } A small list of sample products.
                 */
        function getFallbackProducts() {
            return [
                { productId: 1, name: "Kesar Chandan", scentFamily: "Spicy", categoryName: "Signature Blends", description: "Luxurious warmth of saffron...", imageUrl: "/images/products/Kesar Chandan.jpeg", variants: [{ variantId: 101, size: "6ml", price: 240, stockQuantity: 50 }, { variantId: 102, size: "12ml", price: 450, stockQuantity: 30 }] },
                { productId: 2, name: "Black OUD", scentFamily: "Woody", categoryName: "Attars & Oud", description: "Darkness refined into a fragrance.", imageUrl: "/images/products/Black OUD.jpeg", variants: [{ variantId: 201, size: "6ml", price: 600, stockQuantity: 20 }, { variantId: 202, size: "12ml", price: 1100, stockQuantity: 10 }] },
                { productId: 3, name: "Cairo Evening", scentFamily: "Spicy", categoryName: "Signature Blends", description: "Golden sunsets and ancient streets.", imageUrl: "/images/products/Cairo Evening.jpeg", variants: [{ variantId: 301, size: "6ml", price: 135, stockQuantity: 60 }, { variantId: 302, size: "12ml", price: 225, stockQuantity: 40 }] },
                { productId: 4, name: "Turkish Rose", scentFamily: "Floral", categoryName: "Signature Blends", description: "Timeless beauty of blooming roses.", imageUrl: "/images/products/Turkish Rose.jpeg", variants: [{ variantId: 401, size: "6ml", price: 390, stockQuantity: 30 }, { variantId: 402, size: "12ml", price: 750, stockQuantity: 20 }] }
            ];
        }

        // ---- 13. URL CATEGORY FILTER ----
        /**
         * Applies a category filter from the URL query parameter.
         * Used when navigating from other pages with ?category=... parameter.
         */
        function applyCategoryFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            const categoryParam = urlParams.get('category');
            if (categoryParam) {
                const filterBtn = document.querySelector(`.filter-btn[data-filter="${categoryParam}"]`);
                if (filterBtn) {
                    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                    filterBtn.classList.add('active');
                    activeFilter = categoryParam;
                    setTimeout(applyFiltersAndSort, 100);
                }
            }
        }

        // ---- 14. INIT ----
        /**
         * Initializes the catalog page.
         * Loads products, applies URL filters, and sets up the sticky tracker.
         */
        loadProducts();

        window.addEventListener('DOMContentLoaded', () => {
            applyCategoryFromUrl();
            updateCartBadge();
            updateStickyTracker();

            // Handle ?highlight=... parameter for product highlighting
            const urlParams = new URLSearchParams(window.location.search);
            const highlightParam = urlParams.get('highlight');
            if (highlightParam) {
                setTimeout(() => {
                    const targetCard = Array.from(document.querySelectorAll('.product-card')).find(c =>
                        c.dataset.name.toLowerCase() === highlightParam.toLowerCase()
                    );
                    if (targetCard) {
                        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        targetCard.style.outline = '2px solid var(--champagne-gold)';
                        setTimeout(() => {
                            const btn = targetCard.querySelector('.quick-view-btn');
                            if (btn) btn.click();
                        }, 600);
                    }
                }, 500);
            }
        });
    </script>
}