@{
    ViewData["Title"] = "All Fragrances - The Olfactory Collection";
}

<!-- 1. CATALOG HERO BANNER WITH IVORY TEXTURE -->
<section style="position: relative; width: 100%; padding: 3rem 5% 2rem; background: url('/images/flat-ivory-texture.png') center/cover no-repeat; border-bottom: 1px solid var(--border-color); text-align: center;">
    <div style="max-width: 800px; margin: 0 auto;">
        <span style="font-size: 0.8rem; letter-spacing: 3px; color: var(--deep-burgundy); font-weight: 600; display: block; margin-bottom: 0.4rem; text-transform: uppercase;">
            PURE • LUXURY • TIMELESS
        </span>
        <h1 style="font-family: var(--font-heading); color: var(--deep-burgundy); font-size: 2.4rem; margin: 0 0 0.5rem 0; letter-spacing: 1px;">
            The Olfactory Collection
        </h1>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
            Explore our complete range of 100% alcohol-free concentrated attars and artisanal luxury blends.
        </p>
    </div>
</section>

