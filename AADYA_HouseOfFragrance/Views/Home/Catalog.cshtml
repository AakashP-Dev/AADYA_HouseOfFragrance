</section>

<!-- 3. SLIDE-OVER QUICK VIEW DRAWER -->
<div class="drawer-overlay" id="drawerOverlay" onclick="closeProductDrawer()"></div>

<div class="product-drawer" id="productDrawer">
    <button class="drawer-close-btn" onclick="closeProductDrawer()">&times;</button>

    <div class="drawer-content">
        <div class="drawer-img-container">
            <img id="drawerImage" src="" alt="Product Image" />
        </div>

        <div class="drawer-details">
            <span class="drawer-tagline">PURE CONCENTRATED ATTAR</span>
            <h2 class="drawer-title" id="drawerTitle">Product Name</h2>
            <div class="drawer-scent-tag" id="drawerScentTag">Scent Family</div>

            <p class="drawer-desc" id="drawerDesc">
                Fragrance description.
            </p>

            <!-- DUAL SIZE SELECTION WITH INDEPENDENT QUANTITIES -->
            <div class="dual-size-section">
                <label class="size-section-label">Select Quantities for Desired Bottle Sizes:</label>

                <!-- 6ML ROW -->
                <div class="size-qty-row">
                    <div class="size-info">
                        <span class="size-title">6ml Bottle</span>
                        <span class="size-unit-price" id="labelPrice6">₹0.00</span>
                    </div>
                    <div class="qty-selector">
                        <button type="button" class="qty-btn" onclick="updateSizeQty(6, -1)">&minus;</button>
                        <input type="text" id="qty6ml" value="0" readonly class="qty-input" />
                        <button type="button" class="qty-btn" onclick="updateSizeQty(6, 1)">&plus;</button>
                    </div>
                </div>

                <!-- 12ML ROW -->
                <div class="size-qty-row">
                    <div class="size-info">
                        <span class="size-title">12ml Bottle</span>
                        <span class="size-unit-price" id="labelPrice12">₹0.00</span>
                    </div>
                    <div class="qty-selector">
                        <button type="button" class="qty-btn" onclick="updateSizeQty(12, -1)">&minus;</button>
                        <input type="text" id="qty12ml" value="1" readonly class="qty-input" />
                        <button type="button" class="qty-btn" onclick="updateSizeQty(12, 1)">&plus;</button>
                    </div>
                </div>
            </div>

            <!-- TOTAL PRICE DISPLAY -->
            <div class="drawer-price-box">
                <span class="price-label">Total Amount:</span>
                <span class="price-value" id="drawerTotal">₹0.00</span>
            </div>

            <button type="button" class="btn-gold drawer-add-btn" onclick="handleAddToCart()">
                ADD SELECTED TO CART
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentP6 = 0;
        let currentP12 = 0;
        let qty6 = 0;
        let qty12 = 1;

        // --- 1. DRAWER DUAL SIZE LOGIC ---
        function openProductDrawer(btn) {
            const card = btn.closest('.product-card');

            const name = card.dataset.name;
            const family = card.dataset.family;
            const desc = card.dataset.desc;
            const img = card.dataset.img;
            currentP6 = parseInt(card.dataset.price6);
            currentP12 = parseInt(card.dataset.price12);

            document.getElementById('drawerTitle').innerText = name;
            document.getElementById('drawerScentTag').innerText = family;
            document.getElementById('drawerDesc').innerText = desc;
            document.getElementById('drawerImage').src = img;

            document.getElementById('labelPrice6').innerText = '₹' + currentP6 + '.00';
            document.getElementById('labelPrice12').innerText = '₹' + currentP12 + '.00';

            // Reset defaults: 0x 6ml, 1x 12ml
            qty6 = 0;
            qty12 = 1;
            document.getElementById('qty6ml').value = qty6;
            document.getElementById('qty12ml').value = qty12;

            recalculateTotal();

            document.getElementById('drawerOverlay').classList.add('open');
            document.getElementById('productDrawer').classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeProductDrawer() {
            document.getElementById('drawerOverlay').classList.remove('open');
            document.getElementById('productDrawer').classList.remove('open');
            document.body.style.overflow = 'auto';
        }

        function updateSizeQty(size, change) {
            if (size === 6) {
                qty6 += change;
                if (qty6 < 0) qty6 = 0;
                document.getElementById('qty6ml').value = qty6;
            } else if (size === 12) {
                qty12 += change;
                if (qty12 < 0) qty12 = 0;
                document.getElementById('qty12ml').value = qty12;
            }
            recalculateTotal();
        }

        function recalculateTotal() {
            const total = (qty6 * currentP6) + (qty12 * currentP12);
            document.getElementById('drawerTotal').innerText = '₹' + total.toLocaleString('en-IN') + '.00';
        }

        function handleAddToCart() {
            if (qty6 === 0 && qty12 === 0) {
                alert("Please select at least one bottle quantity before adding to cart.");
                return;
            }
            const name = document.getElementById('drawerTitle').innerText;
            const total = document.getElementById('drawerTotal').innerText;

            let summary = `Added ${name} to cart:\n`;
            if (qty6 > 0) summary += `• ${qty6}x 6ml Bottle\n`;
            if (qty12 > 0) summary += `• ${qty12}x 12ml Bottle\n`;
            summary += `Total: ${total}`;

            alert(summary);
            closeProductDrawer();
        }

        // --- 2. INTEGRATED SEARCH, FILTER, SORT & EMPTY STATE LOGIC ---
        const searchInput = document.getElementById('searchInput');
        const sortSelect = document.getElementById('sortSelect');
        const filterPills = document.getElementById('filterPills');
        const productGrid = document.getElementById('productGrid');
        const productCountLabel = document.getElementById('productCountLabel');
        const noResultsContainer = document.getElementById('noResultsContainer');

        let activeFilter = 'all';

        filterPills.addEventListener('click', (e) => {
            if (e.target.classList.contains('filter-btn')) {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                e.target.classList.add('active');
                activeFilter = e.target.dataset.filter;
                applyCatalogFilters();
            }
        });

        searchInput.addEventListener('input', applyCatalogFilters);
        sortSelect.addEventListener('change', applyCatalogFilters);

        function applyCatalogFilters() {
            const query = searchInput.value.toLowerCase().trim();
            const sortVal = sortSelect.value;
            const cards = Array.from(productGrid.children);

            let visibleCount = 0;

            cards.forEach(card => {
                const name = card.dataset.name.toLowerCase();
                const family = card.dataset.family.toLowerCase();
                const category = card.dataset.category;

                const matchesFilter = (activeFilter === 'all' || category === activeFilter);
                const matchesSearch = (name.includes(query) || family.includes(query));

                if (matchesFilter && matchesSearch) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            productCountLabel.innerText = `Showing ${visibleCount} Fragrance${visibleCount === 1 ? '' : 's'}`;

            // TOGGLE NO RESULTS VIEW
            if (visibleCount === 0) {
                noResultsContainer.style.display = 'block';
                productGrid.style.display = 'none';
            } else {
                noResultsContainer.style.display = 'none';
                productGrid.style.display = 'grid';
            }

            // SORTING LOGIC
            const visibleCards = cards.filter(c => c.style.display !== 'none');

            visibleCards.sort((a, b) => {
                const priceA = parseInt(a.dataset.price12);
                const priceB = parseInt(b.dataset.price12);
                const boughtA = parseInt(a.dataset.bought);
                const boughtB = parseInt(b.dataset.bought);

                if (sortVal === 'popular') return boughtB - boughtA;
                if (sortVal === 'low-high') return priceA - priceB;
                if (sortVal === 'high-low') return priceB - priceA;
                return 0;
            });

            visibleCards.forEach(card => productGrid.appendChild(card));
        }

        function resetCatalogFilters() {
            searchInput.value = '';
            activeFilter = 'all';
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            document.querySelector('.filter-btn[data-filter="all"]').classList.add('active');
            sortSelect.value = 'popular';
            applyCatalogFilters();
        }

        // --- 3. DEEP-LINK AUTO-SCROLL & HIGHLIGHT FROM HOME PAGE ---
        window.addEventListener('DOMContentLoaded', () => {
            applyCatalogFilters(); // Run initial sort & filter setup

            const urlParams = new URLSearchParams(window.location.search);
            const highlightParam = urlParams.get('highlight');

            if (highlightParam) {
                const targetCard = Array.from(document.querySelectorAll('.product-card')).find(c =>
                    c.dataset.name.toLowerCase() === highlightParam.toLowerCase()
                );

                if (targetCard) {
                    setTimeout(() => {
                        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        targetCard.style.outline = '2px solid var(--champagne-gold)';
                        targetCard.style.boxShadow = '0 0 20px rgba(203, 164, 99, 0.4)';

                        setTimeout(() => {
                            const btn = targetCard.querySelector('.quick-view-btn');
                            if (btn) openProductDrawer(btn);
                        }, 700);
                    }, 300);
                }
            }
        });
    </script>
}