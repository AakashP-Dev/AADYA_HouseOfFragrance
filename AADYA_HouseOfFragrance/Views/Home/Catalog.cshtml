@{
    ViewData["Title"] = "All Fragrances - The Olfactory Collection";
}

<!-- 1. CATALOG HERO BANNER -->
<section class="catalog-hero-banner">
    <div class="catalog-hero-content">
        <span class="catalog-tagline">PURE • LUXURY • TIMELESS</span>
        <h1 class="catalog-title">The Olfactory Collection</h1>
        <p class="catalog-subtitle">
            Explore our complete range of 100% alcohol-free concentrated attars and artisanal luxury blends.
        </p>
    </div>
</section>

<!-- 2. MAIN CATALOG SECTION -->
<section class="section-padding" style="padding-top: 2rem;">

    <!-- FILTER & SEARCH BAR -->
    <div class="filter-bar-container">
        <div class="filter-pills" id="filterPills">
            <button class="filter-btn active" data-filter="all">All Scents</button>
            <button class="filter-btn" data-filter="oud">Oud & Heritage</button>
            <button class="filter-btn" data-filter="fresh">Aquatic & Fresh</button>
            <button class="filter-btn" data-filter="floral">Floral & Rose</button>
            <button class="filter-btn" data-filter="gourmand">Gourmand & Amber</button>
        </div>

        <div class="search-sort-inputs">
            <input type="text" id="searchInput" placeholder="Search fragrance..." class="custom-input" />
            <select id="sortSelect" class="custom-select">
                <option value="popular">Most Popular</option>
                <option value="low-high">Price: Low to High</option>
                <option value="high-low">Price: High to Low</option>
            </select>
        </div>
    </div>

    <!-- PRODUCT COUNT -->
    <div class="catalog-count-label" id="productCountLabel">Loading Fragrances...</div>

    <!-- DYNAMIC PRODUCT GRID -->
    <div class="product-grid" id="productGrid">
        <!-- Cards will be injected here by JavaScript -->
    </div>

    <!-- NO FRAGRANCES FOUND -->
    <div id="noResultsContainer" class="no-results-box" style="display: none;">
        <div class="no-results-icon">✨</div>
        <h3 class="no-results-title">No Fragrances Found</h3>
        <p class="no-results-text">We couldn't find any fragrances matching your current search or category filter.</p>
        <button class="btn-outline" onclick="resetCatalogFilters()">CLEAR ALL FILTERS</button>
    </div>
</section>

<!-- 3. SLIDE-OVER QUICK VIEW DRAWER -->
<div class="drawer-overlay" id="drawerOverlay" onclick="closeProductDrawer()"></div>
<div class="product-drawer" id="productDrawer">
    <button class="drawer-close-btn" onclick="closeProductDrawer()">&times;</button>
    <div class="drawer-content">
        <div class="drawer-img-container">
            <img id="drawerImage" src="" alt="Product Image" />
        </div>
        <div class="drawer-details">
            <span class="drawer-tagline">PURE CONCENTRATED ATTAR</span>
            <h2 class="drawer-title" id="drawerTitle">Product Name</h2>
            <div class="drawer-scent-tag" id="drawerScentTag">Scent Family</div>
            <p class="drawer-desc" id="drawerDesc">Fragrance description.</p>

            <!-- DUAL SIZE SELECTION -->
            <div class="dual-size-section">
                <label class="size-section-label">Select Quantities for Desired Bottle Sizes:</label>
                <div id="variantSelectorContainer">
                    <!-- Variants will be injected here dynamically -->
                </div>
            </div>

            <!-- TOTAL PRICE DISPLAY -->
            <div class="drawer-price-box">
                <span class="price-label">Total Amount:</span>
                <span class="price-value" id="drawerTotal">₹0.00</span>
            </div>
            <button type="button" class="btn-gold drawer-add-btn" onclick="handleAddToCart()">ADD SELECTED TO CART</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- GLOBAL STATE ---
        let allProducts = [];
        let activeFilter = 'all';
        let currentDrawerVariants = []; // To hold variants of the product in drawer

        // --- 1. FETCH PRODUCTS FROM API ---
        async function loadProducts() {
            try {
                // TODO: Replace with actual API endpoint when backend is ready
                // For now, we simulate a fetch. In Week 7, this will hit /api/products
                const response = await fetch('/api/products');
                if (!response.ok) throw new Error('Network response was not ok');
                allProducts = await response.json();
                renderCatalog(allProducts);
            } catch (error) {
                console.error('Failed to load products:', error);
                // Fallback to hardcoded data if API is not ready (REMOVE THIS IN PRODUCTION)
                allProducts = getFallbackProducts();
                renderCatalog(allProducts);
            }
        }

        // --- 2. RENDER PRODUCT GRID ---
        function renderCatalog(products) {
            const grid = document.getElementById('productGrid');
            const countLabel = document.getElementById('productCountLabel');

            if (!products || products.length === 0) {
                grid.style.display = 'none';
                document.getElementById('noResultsContainer').style.display = 'block';
                countLabel.innerText = 'Showing 0 Fragrances';
                return;
            }

            grid.style.display = 'grid';
            document.getElementById('noResultsContainer').style.display = 'none';
            countLabel.innerText = `Showing ${products.length} Fragrance${products.length === 1 ? '' : 's'}`;

            // Clear and rebuild grid
            grid.innerHTML = '';
            products.forEach(product => {
                // Find the cheapest variant to display price range
                const prices = product.variants.map(v => v.price);
                const minPrice = Math.min(...prices);
                const maxPrice = Math.max(...prices);
                const priceDisplay = minPrice === maxPrice ? `₹${minPrice}.00` : `₹${minPrice}.00 – ₹${maxPrice}.00`;

                // Construct Image URL (use placeholder if missing)
                const imgSrc = product.imageUrl || 'https://via.placeholder.com/300x220?text=' + encodeURIComponent(product.name);

                // Calculate average price for sorting
                const avgPrice = prices.reduce((a, b) => a + b, 0) / prices.length;

                const card = document.createElement('div');
                card.className = 'product-card';
                card.dataset.name = product.name;
                card.dataset.category = product.categoryName?.toLowerCase() || 'general';
                card.dataset.productId = product.productId;
                card.dataset.price = Math.round(avgPrice); // <-- ADD THIS for sorting
                card.dataset.bought = product.totalSold || 0; // <-- ADD THIS for popularity sorting

                card.innerHTML = `
                            <img src="${imgSrc}" alt="${product.name}" onerror="this.src='https://via.placeholder.com/300x220?text=${encodeURIComponent(product.name)}'" />
                            <h3>${product.name}</h3>
                            <span class="scent-tag">${product.scentFamily || 'Fragrance'}</span>
                            <div class="product-price">${priceDisplay}</div>
                            <button class="btn-gold quick-view-btn" onclick="openProductDrawer(${product.productId})">VIEW DETAILS</button>
                        `;
                grid.appendChild(card);
            });

            // Re-apply filter/sort state after rendering
            applyFiltersAndSort();
        }

        // --- 3. FILTER, SORT, SEARCH LOGIC ---
        function applyFiltersAndSort() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const sortVal = document.getElementById('sortSelect').value;
            const cards = Array.from(document.getElementById('productGrid').children);

            let visibleCount = 0;
            cards.forEach(card => {
                const name = card.dataset.name.toLowerCase();
                const category = card.dataset.category;
                const matchesFilter = (activeFilter === 'all' || category === activeFilter);
                const matchesSearch = name.includes(query);

                if (matchesFilter && matchesSearch) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            document.getElementById('productCountLabel').innerText = `Showing ${visibleCount} Fragrance${visibleCount === 1 ? '' : 's'}`;
            document.getElementById('noResultsContainer').style.display = visibleCount === 0 ? 'block' : 'none';
            document.getElementById('productGrid').style.display = visibleCount === 0 ? 'none' : 'grid';

            // SORT VISIBLE CARDS (Re-order DOM)
            const visibleCards = cards.filter(c => c.style.display !== 'none');
            visibleCards.sort((a, b) => {
                const priceA = parseInt(a.dataset.price) || 0;
                const priceB = parseInt(b.dataset.price) || 0;
                const boughtA = parseInt(a.dataset.bought) || 0;
                const boughtB = parseInt(b.dataset.bought) || 0;

                if (sortVal === 'popular') return boughtB - boughtA;
                if (sortVal === 'low-high') return priceA - priceB;
                if (sortVal === 'high-low') return priceB - priceA;
                return 0;
            });
            // Append sorted cards back to grid
            visibleCards.forEach(card => document.getElementById('productGrid').appendChild(card));
        }

        // --- 4. DRAWER: OPEN WITH PRODUCT ID ---
        async function openProductDrawer(productId) {
            // Find product from allProducts array
            const product = allProducts.find(p => p.productId === productId);
            if (!product) return;

            currentDrawerVariants = product.variants || [];

            document.getElementById('drawerTitle').innerText = product.name;
            document.getElementById('drawerScentTag').innerText = product.scentFamily || 'Fragrance';
            document.getElementById('drawerDesc').innerText = product.description || 'A beautifully crafted artisanal attar.';
            document.getElementById('drawerImage').src = product.imageUrl || 'https://via.placeholder.com/300x220?text=' + encodeURIComponent(product.name);

            // Render Variant Rows
            const container = document.getElementById('variantSelectorContainer');
            container.innerHTML = '';
            currentDrawerVariants.forEach((variant, index) => {
                const row = document.createElement('div');
                row.className = 'size-qty-row';
                row.dataset.variantId = variant.variantId;
                row.dataset.price = variant.price;
                row.innerHTML = `
                            <div class="size-info">
                                <span class="size-title">${variant.size} Bottle</span>
                                <span class="size-unit-price">₹${variant.price}.00</span>
                            </div>
                            <div class="qty-selector">
                                <button type="button" class="qty-btn" onclick="updateDrawerQty(${index}, -1)">&minus;</button>
                                <input type="text" id="drawerQty_${index}" value="${index === 0 ? 0 : 1}" readonly class="qty-input" />
                                <button type="button" class="qty-btn" onclick="updateDrawerQty(${index}, 1)">&plus;</button>
                            </div>
                        `;
                container.appendChild(row);
            });

            recalculateDrawerTotal();
            document.getElementById('drawerOverlay').classList.add('open');
            document.getElementById('productDrawer').classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeProductDrawer() {
            document.getElementById('drawerOverlay').classList.remove('open');
            document.getElementById('productDrawer').classList.remove('open');
            document.body.style.overflow = 'auto';
        }

        function updateDrawerQty(index, change) {
            const input = document.getElementById('drawerQty_' + index);
            let val = parseInt(input.value) + change;
            if (val < 0) val = 0;
            input.value = val;
            recalculateDrawerTotal();
        }

        function recalculateDrawerTotal() {
            let total = 0;
            const rows = document.querySelectorAll('#variantSelectorContainer .size-qty-row');
            rows.forEach(row => {
                const price = parseFloat(row.dataset.price);
                const qtyInput = row.querySelector('.qty-input');
                const qty = parseInt(qtyInput.value);
                total += price * qty;
            });
            document.getElementById('drawerTotal').innerText = '₹' + total.toLocaleString('en-IN') + '.00';
        }

        function handleAddToCart() {
            let items = [];
            const rows = document.querySelectorAll('#variantSelectorContainer .size-qty-row');
            rows.forEach(row => {
                const qty = parseInt(row.querySelector('.qty-input').value);
                if (qty > 0) {
                    items.push({
                        variantId: parseInt(row.dataset.variantId),
                        quantity: qty
                    });
                }
            });

            if (items.length === 0) {
                alert("Please select at least one bottle quantity.");
                return;
            }

            // TODO: Send this to backend /api/cart
            console.log('Adding to cart:', items);
            alert('Items added to cart! (Backend integration coming in Week 9)');
            closeProductDrawer();
        }

        // --- 5. EVENT LISTENERS ---
        document.getElementById('searchInput').addEventListener('input', applyFiltersAndSort);
        document.getElementById('sortSelect').addEventListener('change', applyFiltersAndSort);

        document.getElementById('filterPills').addEventListener('click', (e) => {
            if (e.target.classList.contains('filter-btn')) {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                e.target.classList.add('active');
                activeFilter = e.target.dataset.filter;
                applyFiltersAndSort();
            }
        });

        window.resetCatalogFilters = function() {
            document.getElementById('searchInput').value = '';
            document.getElementById('sortSelect').value = 'popular';
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            document.querySelector('.filter-btn[data-filter="all"]').classList.add('active');
            activeFilter = 'all';
            applyFiltersAndSort();
        };

        // --- 6. FALLBACK DATA (REMOVE IN PRODUCTION) ---
        function getFallbackProducts() {
            // This is a condensed fallback just to show the UI works.
            // You should delete this entire function once you connect to the real API.
            return [
                { productId: 1, name: "Kesar Chandan", scentFamily: "Saffron • Sandalwood", categoryName: "Gourmand", description: "Luxurious warmth of saffron...", imageUrl: "/images/products/Kesar Chandan.jpeg", variants: [{ variantId: 101, size: "6ml", price: 240 }, { variantId: 102, size: "12ml", price: 450 }] },
                { productId: 2, name: "Black OUD", scentFamily: "Oud • Woody", categoryName: "Oud", description: "Darkness refined into a fragrance.", imageUrl: "/images/products/Black OUD.jpeg", variants: [{ variantId: 201, size: "6ml", price: 600 }, { variantId: 202, size: "12ml", price: 1100 }] },
                { productId: 3, name: "Cairo Evening", scentFamily: "Oriental • Woody", categoryName: "Gourmand", description: "Golden sunsets and ancient streets.", imageUrl: "/images/products/Cairo Evening.jpeg", variants: [{ variantId: 301, size: "6ml", price: 135 }, { variantId: 302, size: "12ml", price: 225 }] },
                { productId: 4, name: "Turkish Rose", scentFamily: "Rose • Floral", categoryName: "Floral", description: "Timeless beauty of blooming roses.", imageUrl: "/images/products/Turkish Rose.jpeg", variants: [{ variantId: 401, size: "6ml", price: 390 }, { variantId: 402, size: "12ml", price: 750 }] }
            ];
        }

        // --- INITIALIZE ---
        loadProducts();

        // Handle Deep Link Highlight
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const highlightParam = urlParams.get('highlight');
            if (highlightParam) {
                setTimeout(() => {
                    const targetCard = Array.from(document.querySelectorAll('.product-card')).find(c =>
                        c.dataset.name.toLowerCase() === highlightParam.toLowerCase()
                    );
                    if (targetCard) {
                        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        targetCard.style.outline = '2px solid var(--champagne-gold)';
                        setTimeout(() => {
                            const btn = targetCard.querySelector('.quick-view-btn');
                            if (btn) btn.click();
                        }, 600);
                    }
                }, 500);
            }
        });

        // --- Handle Category Filter from URL ---
        function applyCategoryFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            const categoryParam = urlParams.get('category');

            if (categoryParam) {
                // Find the filter button with matching data-filter
                const filterBtn = document.querySelector(`.filter-btn[data-filter="${categoryParam}"]`);
                if (filterBtn) {
                    // Remove active class from all filter buttons
                    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                    // Add active class to matching button
                    filterBtn.classList.add('active');
                    // Update activeFilter variable
                    activeFilter = categoryParam;
                    // Re-apply filters (after products are loaded)
                    setTimeout(applyFiltersAndSort, 100);
                }
            }
        }

        // Modify the DOMContentLoaded event listener to call applyCategoryFromUrl
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const highlightParam = urlParams.get('highlight');
            if (highlightParam) {
                setTimeout(() => {
                    const targetCard = Array.from(document.querySelectorAll('.product-card')).find(c =>
                        c.dataset.name.toLowerCase() === highlightParam.toLowerCase()
                    );
                    if (targetCard) {
                        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        targetCard.style.outline = '2px solid var(--champagne-gold)';
                        setTimeout(() => {
                            const btn = targetCard.querySelector('.quick-view-btn');
                            if (btn) btn.click();
                        }, 600);
                    }
                }, 500);
            }

            // ADD THIS LINE to apply category filter from URL
            applyCategoryFromUrl();
        });
    </script>
}