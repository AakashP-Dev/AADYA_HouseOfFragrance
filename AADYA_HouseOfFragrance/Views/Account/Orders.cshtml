﻿@{
ViewData["Title"] = "My Orders - AADYA";
}

<section class="section-padding" style="padding-top: 2rem; min-height: 70vh;">
    <div style="max-width: 900px; margin: 0 auto;">

        <!-- Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
            <div>
                <h1 style="font-family: var(--font-heading); color: var(--deep-burgundy); margin: 0;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:10px;">
                        <rect x="2" y="3" width="20" height="18" rx="2" />
                        <line x1="8" y1="9" x2="16" y2="9" />
                        <line x1="8" y1="13" x2="16" y2="13" />
                        <line x1="8" y1="17" x2="12" y2="17" />
                    </svg>
                    My Orders
                </h1>
                <p style="color: var(--text-muted); margin: 0.2rem 0 0 0;">View your complete purchase history and order status.</p>
            </div>
            <a href="/Home/Catalog" class="btn-outline" style="font-size: 0.75rem; padding: 0.4rem 1.2rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:4px;">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
                CONTINUE SHOPPING
            </a>
        </div>

        <!-- Orders Container -->
        <div id="ordersContainer" style="background: #FAF6EF; border: 1px solid var(--border-color); border-radius: 4px; padding: 1.5rem;">

            <!-- Loading State -->
            <div id="ordersLoading" style="text-align: center; padding: 2rem;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--champagne-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:0.5rem;">
                    <line x1="12" y1="2" x2="12" y2="6" />
                    <line x1="12" y1="18" x2="12" y2="22" />
                    <line x1="4.93" y1="4.93" x2="7.76" y2="7.76" />
                    <line x1="16.24" y1="16.24" x2="19.07" y2="19.07" />
                    <line x1="2" y1="12" x2="6" y2="12" />
                    <line x1="18" y1="12" x2="22" y2="12" />
                    <line x1="4.93" y1="19.07" x2="7.76" y2="16.24" />
                    <line x1="16.24" y1="7.76" x2="19.07" y2="4.93" />
                </svg>
                <p style="color: var(--text-muted);">Loading your orders...</p>
            </div>

            <!-- Orders List -->
            <div id="ordersList" style="display: none;">
                <!-- Orders will be injected here -->
            </div>

            <!-- Empty State -->
            <div id="ordersEmpty" style="display: none; text-align: center; padding: 2.5rem 1rem;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--border-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:0.5rem;">
                    <rect x="2" y="3" width="20" height="18" rx="2" />
                    <line x1="8" y1="9" x2="16" y2="9" />
                    <line x1="8" y1="13" x2="16" y2="13" />
                    <line x1="8" y1="17" x2="12" y2="17" />
                </svg>
                <h3 style="font-family: var(--font-heading); color: var(--deep-burgundy); margin: 0 0 0.5rem 0;">No Orders Yet</h3>
                <p style="color: var(--text-muted); margin-bottom: 1.5rem;">You haven't placed any orders. Browse our collection and find your perfect scent!</p>
                <a href="/Home/Catalog" class="btn-gold">EXPLORE FRAGRANCES</a>
            </div>

            <!-- Not Logged In State -->
            <div id="ordersNotLoggedIn" style="display: none; text-align: center; padding: 2.5rem 1rem;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--border-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:0.5rem;">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                <h3 style="font-family: var(--font-heading); color: var(--deep-burgundy); margin: 0 0 0.5rem 0;">Please Login</h3>
                <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Login to view your order history.</p>
                <a href="/Account/Login" class="btn-gold">SIGN IN</a>
            </div>

            <!-- Error State -->
            <div id="ordersError" style="display: none; text-align: center; padding: 2rem;">
                <p style="color: #d32f2f; margin-bottom: 1rem; font-size: 0.95rem;" id="ordersErrorMessage">Failed to load your orders. Please try again.</p>
                <button class="btn-gold" onclick="loadOrders()" style="font-size:0.8rem; padding:0.4rem 1.2rem;">RETRY</button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        async function loadOrders() {
            const loadingEl = document.getElementById('ordersLoading');
            const listEl = document.getElementById('ordersList');
            const emptyEl = document.getElementById('ordersEmpty');
            const notLoggedInEl = document.getElementById('ordersNotLoggedIn');
            const errorEl = document.getElementById('ordersError');

            // Hide all states
            loadingEl.style.display = 'none';
            listEl.style.display = 'none';
            emptyEl.style.display = 'none';
            notLoggedInEl.style.display = 'none';
            errorEl.style.display = 'none';

            const token = localStorage.getItem('token');
            if (!token) {
                notLoggedInEl.style.display = 'block';
                return;
            }

            loadingEl.style.display = 'block';

            try {
                console.log('Fetching orders...');
                const response = await fetch('/api/orders', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                console.log('Response status:', response.status);

                // Check if response is OK before parsing JSON
                if (!response.ok) {
                    // Try to get error message, fallback to status text
                    let errorMessage = '';
                    try {
                        const errorData = await response.json();
                        errorMessage = errorData.message || response.statusText;
                    } catch (e) {
                        // If response is empty or not JSON, use status text
                        errorMessage = response.statusText || 'Unknown error';
                    }

                    if (response.status === 401) {
                        // Token expired or invalid
                        localStorage.removeItem('token');
                        localStorage.removeItem('userName');
                        localStorage.removeItem('userId');
                        notLoggedInEl.style.display = 'block';
                        return;
                    }

                    throw new Error(`HTTP ${response.status}: ${errorMessage}`);
                }

                // Now safe to parse JSON
                let orders;
                try {
                    orders = await response.json();
                } catch (jsonError) {
                    throw new Error('Received invalid response from server.');
                }

                loadingEl.style.display = 'none';

                if (!orders || orders.length === 0) {
                    emptyEl.style.display = 'block';
                    return;
                }

                listEl.style.display = 'block';
                renderOrders(orders);

            } catch (error) {
                console.error('Error loading orders:', error);
                loadingEl.style.display = 'none';
                document.getElementById('ordersErrorMessage').textContent = error.message || 'Failed to load your orders. Please try again.';
                errorEl.style.display = 'block';
            }
        }

        function renderOrders(orders) {
            const container = document.getElementById('ordersList');
            container.innerHTML = '';

            orders.forEach(order => {
                const statusClass = order.orderStatus.toLowerCase();
                const date = new Date(order.createdAt).toLocaleDateString('en-IN', {
                    day: 'numeric', month: 'long', year: 'numeric'
                });
                const time = new Date(order.createdAt).toLocaleTimeString('en-IN', {
                    hour: '2-digit', minute: '2-digit'
                });

                const orderCard = document.createElement('div');
                orderCard.style.cssText = `
                            background: var(--warm-ivory);
                            border: 1px solid var(--border-color);
                            border-radius: 4px;
                            padding: 1.2rem 1.5rem;
                            margin-bottom: 1.2rem;
                            transition: box-shadow 0.2s;
                        `;
                orderCard.onmouseover = () => orderCard.style.boxShadow = '0 4px 12px rgba(59,14,20,0.06)';
                orderCard.onmouseout = () => orderCard.style.boxShadow = 'none';

                // Header
                const header = document.createElement('div');
                header.style.cssText = `
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                            flex-wrap: wrap;
                            gap: 0.5rem;
                            padding-bottom: 0.6rem;
                            border-bottom: 1px solid var(--border-color);
                            margin-bottom: 0.6rem;
                        `;
                header.innerHTML = `
                            <div>
                                <strong style="font-size: 1.05rem; font-family: monospace;">#AAD-${order.orderId.toString().padStart(4, '0')}</strong>
                                <span style="font-size: 0.8rem; color: var(--text-muted); margin-left: 0.8rem;">${date} at ${time}</span>
                            </div>
                            <span class="status-pill status-${statusClass}">${order.orderStatus}</span>
                        `;
                orderCard.appendChild(header);

                // Items
                const itemsContainer = document.createElement('div');
                itemsContainer.style.cssText = `padding: 0.3rem 0;`;
                let itemsHtml = '';
                order.items.forEach((item, index) => {
                    itemsHtml += `
                                <div style="display: flex; justify-content: space-between; font-size: 0.88rem; padding: 0.3rem 0; ${index > 0 ? 'border-top: 1px dashed var(--border-color);' : ''}">
                                    <span>
                                        <span style="font-weight:500;">${item.productName}</span>
                                        <span style="color: var(--text-muted); font-size: 0.8rem;">(${item.size})</span>
                                        <span style="color: var(--text-muted); font-size: 0.8rem;">× ${item.quantity}</span>
                                    </span>
                                    <span style="font-weight: 600; color: var(--deep-burgundy);">₹${item.total.toFixed(2)}</span>
                                </div>
                            `;
                });
                itemsContainer.innerHTML = itemsHtml;
                orderCard.appendChild(itemsContainer);

                // Footer
                const footer = document.createElement('div');
                footer.style.cssText = `
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    flex-wrap: wrap;
                    gap: 0.5rem;
                    padding-top: 0.6rem;
                    border-top: 1px solid var(--border-color);
                    margin-top: 0.6rem;
                    font-size: 0.85rem;
                `;

                const canCancel = order.orderStatus === 'Pending Payment' || order.orderStatus === 'Processing';

                footer.innerHTML = `
                    <span style="color: var(--text-muted);">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:4px;">
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                            <path d="M22 6L12 13 2 6" />
                        </svg>
                        ${order.shippingAddress}
                    </span>
                    <div style="display:flex; align-items:center; gap:1rem;">
                        <span style="font-weight: 700; font-size: 1.05rem; color: var(--deep-burgundy);">
                            Total: ₹${order.totalAmount.toFixed(2)}
                        </span>
                        ${canCancel ? `<button onclick="cancelOrder(${order.orderId})" style="background:transparent; border:1px solid #d32f2f; color:#d32f2f; padding:0.3rem 0.8rem; border-radius:4px; font-size:0.7rem; font-weight:600; cursor:pointer; transition:all 0.3s;" onmouseover="this.style.backgroundColor='#d32f2f';this.style.color='white';" onmouseout="this.style.backgroundColor='transparent';this.style.color='#d32f2f';">CANCEL</button>` : ''}
                    </div>
                `;
                orderCard.appendChild(footer);
                container.appendChild(orderCard);
            });
        }

        document.addEventListener('DOMContentLoaded', loadOrders);

        // --- Cancel Order ---
        async function cancelOrder(orderId) {
            // Show confirmation modal
            showGlobalConfirmModal(
                `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d32f2f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>`,
                'Cancel Order',
                'Are you sure you want to cancel this order? <br><br> This action cannot be undone.',
                async function() {
                    const token = localStorage.getItem('token');
                    try {
                        const response = await fetch(`/api/orders/cancel/${orderId}`, {
                            method: 'POST',
                            headers: { 'Authorization': 'Bearer ' + token }
                        });
                        const data = await response.json();
                        if (response.ok) {
                            showToast(data.message, 'success');
                            loadOrders(); // Refresh the orders list
                        } else {
                            showToast(data.message || 'Failed to cancel order.', 'error');
                        }
                    } catch (error) {
                        console.error('Error cancelling order:', error);
                        showToast('Network error. Please try again.', 'error');
                    }
                }
            );
        }
    </script>
}