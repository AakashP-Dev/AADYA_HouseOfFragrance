@{
    ViewData["Title"] = "My Profile - AADYA";
}

<section class="section-padding" style="min-height: 70vh; padding-top: 2rem;">
    <div style="max-width: 700px; margin: 0 auto;">
        <!-- HEADER -->
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2rem;">
            <div>
                <h1 style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0;">My Profile</h1>
                <p style="color:var(--text-muted); margin:0.2rem 0 0 0;">View and manage your personal information.</p>
            </div>
            <div id="profileActions">
                <button id="editProfileBtn" class="btn-gold" onclick="enableEdit()" style="font-size:0.75rem; padding:0.5rem 1.2rem;">✏️ EDIT PROFILE</button>
            </div>
        </div>

        <!-- PROFILE CARD -->
        <div id="profileContainer" style="background: #FAF6EF; border:1px solid var(--border-color); border-radius:4px; padding:2rem;">
            <div id="profileLoading" style="text-align:center; padding:2rem;">
                <p>Loading profile...</p>
            </div>

            <div id="profileContent" style="display:none;">
                <!-- AVATAR SECTION -->
                <div style="display:flex; align-items:center; gap:1.5rem; margin-bottom:1.5rem; flex-wrap:wrap;">
                    <div id="avatarContainer" style="position:relative; width:80px; height:80px; border-radius:50%; overflow:hidden; border:2px solid var(--border-color); background:#FAF6EF;">
                        <img id="avatarPreview" src="" alt="Avatar" style="width:100%; height:100%; object-fit:cover; display:block;" />
                        <span id="avatarPlaceholder" style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); font-size:2rem; color:var(--text-muted);">👤</span>
                    </div>
                    <div>
                        <button class="btn-outline" onclick="document.getElementById('avatarInput').click()" style="font-size:0.75rem; padding:0.4rem 1rem;">📷 Change Avatar</button>
                        <input type="file" id="avatarInput" accept="image/*" style="display:none;" onchange="handleAvatarUpload(event)" />
                        <p style="font-size:0.7rem; color:var(--text-muted); margin:0.2rem 0 0 0;">Max size: 2MB (JPG, PNG, GIF)</p>
                    </div>
                </div>

                <!-- Profile Form -->
                <form id="profileForm" style="max-width:500px; margin:0 auto;">
                    <div class="form-group">
                        <label for="profileFullName">Full Name</label>
                        <input type="text" id="profileFullName" class="custom-input" style="width:100%;" readonly />
                    </div>
                    <div class="form-group">
                        <label for="profileEmail">Email Address</label>
                        <input type="email" id="profileEmail" class="custom-input" style="width:100%;" readonly />
                    </div>
                    <div class="form-group">
                        <label for="profilePhone">Phone Number</label>
                        <input type="tel" id="profilePhone" class="custom-input" style="width:100%;" readonly />
                    </div>
                    <div class="form-group">
                        <label for="profileAddress">Delivery Address</label>
                        <textarea id="profileAddress" class="custom-input custom-textarea" rows="3" style="width:100%;" readonly></textarea>
                    </div>
                    <div class="form-group" style="margin-top:0.5rem;">
                        <label style="color:var(--text-muted); font-size:0.8rem;">Account Created</label>
                        <p id="profileCreatedAt" style="margin:0; color:var(--text-muted); font-size:0.85rem;"></p>
                    </div>

                    <div id="editActions" style="display:none; margin-top:1.5rem; padding-top:1.5rem; border-top:1px solid var(--border-color); text-align:center;">
                        <button type="submit" class="btn-gold" style="font-size:0.8rem; padding:0.6rem 2rem;">💾 SAVE CHANGES</button>
                        <button type="button" class="btn-outline" onclick="cancelEdit()" style="font-size:0.8rem; padding:0.6rem 2rem; margin-left:0.5rem;">CANCEL</button>
                    </div>
                </form>

                <!-- QUICK ACTIONS -->
                <div style="margin-top:2rem; padding-top:1.5rem; border-top:1px solid var(--border-color); display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;">
                    <button class="btn-outline" onclick="openChangePassword()" style="font-size:0.75rem; padding:0.5rem 1.2rem;">🔑 Change Password</button>
                    <button class="btn-outline" onclick="openAddressBook()" style="font-size:0.75rem; padding:0.5rem 1.2rem;">📮 Address Book</button>
                </div>
            </div>
        </div>

        <!-- DELETE ACCOUNT SECTION -->
        <div style="margin-top:2rem; padding:1.5rem; background: #fff5f5; border:1px solid #f8d7da; border-radius:4px;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
                <div>
                    <h4 style="color:#d32f2f; margin:0; font-family:var(--font-heading);">⚠️ Delete Account</h4>
                    <p style="color:var(--text-muted); margin:0.2rem 0 0 0; font-size:0.85rem;">Once deleted, all your data (orders, profile, history) will be permanently removed.</p>
                </div>
                <button class="btn-danger" onclick="confirmDeleteAccount()" style="padding:0.6rem 1.5rem; border:1px solid #d32f2f; background:transparent; color:#d32f2f; border-radius:4px; font-weight:600; cursor:pointer; transition:0.3s;">
                    DELETE ACCOUNT
                </button>
            </div>
        </div>
    </div>
</section>

<!-- CHANGE PASSWORD MODAL -->
<div id="changePasswordModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9998; align-items:center; justify-content:center;">
    <div style="background:white; padding:2rem; border-radius:8px; max-width:450px; box-shadow:0 4px 20px rgba(0,0,0,0.3); width:90%;">
        <h3 style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 1.5rem 0; text-align:center;">Change Password</h3>
        <form id="changePasswordForm">
            <div class="form-group">
                <label for="oldPassword">Current Password</label>
                <div class="password-wrapper">
                    <input type="password" id="oldPassword" class="custom-input" style="width:100%;" required />
                    <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('oldPassword', this)" aria-label="Toggle password visibility">
                        <svg class="eye-icon eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                        <svg class="eye-icon eye-on" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="form-group">
                <label for="newPassword">New Password</label>
                <div class="password-wrapper">
                    <input type="password" id="newPassword" class="custom-input" style="width:100%;" required minlength="8" />
                    <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('newPassword', this)" aria-label="Toggle password visibility">
                        <svg class="eye-icon eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                        <svg class="eye-icon eye-on" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <span style="font-size:0.75rem; color:var(--text-muted);">Minimum 8 characters with uppercase, lowercase, number, and special character.</span>
            </div>
            <div class="form-group">
                <label for="confirmNewPassword">Confirm New Password</label>
                <div class="password-wrapper">
                    <input type="password" id="confirmNewPassword" class="custom-input" style="width:100%;" required />
                    <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('confirmNewPassword', this)" aria-label="Toggle password visibility">
                        <svg class="eye-icon eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                        <svg class="eye-icon eye-on" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </div>
            <div style="display:flex; gap:1rem; justify-content:center; margin-top:1.5rem;">
                <button type="submit" class="btn-gold">UPDATE PASSWORD</button>
                <button type="button" class="btn-outline" onclick="closeChangePassword()">CANCEL</button>
            </div>
        </form>
    </div>
</div>

<!-- ADDRESS BOOK MODAL -->
<div id="addressBookModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9997; align-items:center; justify-content:center; overflow-y:auto;">
    <div style="background:white; padding:2rem 2.5rem; border-radius:8px; max-width:560px; box-shadow:0 4px 20px rgba(0,0,0,0.3); width:90%; max-height:90vh; overflow-y:auto;">
        <h3 style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 1.5rem 0; text-align:center; font-size:1.5rem;">📮 Address Book</h3>

        <!-- Address List -->
        <div id="addressList" style="margin-bottom:2rem;">
            <!-- Items will be injected here -->
        </div>

        <!-- Divider -->
        <hr style="border: none; border-top: 1px solid var(--border-color); margin: 1.5rem 0;" />

        <!-- Add Address Form -->
        <form id="addAddressForm">
            <h4 style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 1.2rem 0; font-size:1.1rem;">Add New Address</h4>

            <div class="form-group">
                <label for="addrLabel">Label</label>
                <select id="addrLabel" class="custom-select" style="width:100%; padding:0.55rem 0.9rem; border-radius:2px; border:1px solid var(--border-color); background:#fff; font-size:0.85rem;">
                    <option value="Home">🏠 Home</option>
                    <option value="Office">🏢 Office</option>
                    <option value="Other">📍 Other</option>
                </select>
            </div>

            <div class="form-group">
                <label for="addrLine1">Address Line 1</label>
                <input type="text" id="addrLine1" class="custom-input" style="width:100%; padding:0.55rem 0.9rem; border:1px solid var(--border-color); border-radius:2px; font-size:0.85rem;" required />
            </div>

            <div class="form-group">
                <label for="addrLine2">Address Line 2 <span style="color:var(--text-muted); font-weight:400;">(Optional)</span></label>
                <input type="text" id="addrLine2" class="custom-input" style="width:100%; padding:0.55rem 0.9rem; border:1px solid var(--border-color); border-radius:2px; font-size:0.85rem;" />
            </div>

            <!-- Two-column layout for City & State -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                <div class="form-group">
                    <label for="addrCity">City</label>
                    <input type="text" id="addrCity" class="custom-input" style="width:100%; padding:0.55rem 0.9rem; border:1px solid var(--border-color); border-radius:2px; font-size:0.85rem;" required />
                </div>
                <div class="form-group">
                    <label for="addrState">State</label>
                    <input type="text" id="addrState" class="custom-input" style="width:100%; padding:0.55rem 0.9rem; border:1px solid var(--border-color); border-radius:2px; font-size:0.85rem;" required />
                </div>
            </div>

            <!-- Two-column layout for Pincode & Phone -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                <div class="form-group">
                    <label for="addrPincode">Pincode</label>
                    <input type="text" id="addrPincode" class="custom-input" style="width:100%; padding:0.55rem 0.9rem; border:1px solid var(--border-color); border-radius:2px; font-size:0.85rem;" required pattern="[0-9]{6}" />
                </div>
                <div class="form-group">
                    <label for="addrPhone">Phone</label>
                    <input type="tel" id="addrPhone" class="custom-input" style="width:100%; padding:0.55rem 0.9rem; border:1px solid var(--border-color); border-radius:2px; font-size:0.85rem;" required />
                </div>
            </div>

            <div class="form-group" style="margin-top:0.5rem;">
                <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
                    <input type="checkbox" id="addrIsDefault" style="width:18px; height:18px; accent-color:var(--champagne-gold);" />
                    <span>Set as default address</span>
                </label>
            </div>

            <button type="submit" class="btn-gold" style="width:100%; font-size:0.85rem; padding:0.75rem; margin-top:0.5rem;">➕ ADD ADDRESS</button>
        </form>

        <div style="margin-top:1.5rem; text-align:center;">
            <button type="button" class="btn-outline" onclick="closeAddressBook()" style="font-size:0.85rem; padding:0.5rem 1.8rem;">CLOSE</button>
        </div>
    </div>
</div>

<!-- CONFIRMATION MODAL -->
<div id="confirmModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; padding:2rem; border-radius:8px; max-width:420px; text-align:center; box-shadow:0 4px 20px rgba(0,0,0,0.3); width:90%;">
        <div id="modalIcon" style="font-size:3rem; margin-bottom:0.5rem;">⚠️</div>
        <h3 id="modalTitle" style="font-family:var(--font-heading); color:var(--deep-burgundy); margin:0 0 0.5rem 0;">Confirm Action</h3>
        <p id="modalMessage" style="color:var(--text-muted); margin:0 0 1.5rem 0; line-height:1.6;"></p>
        <div style="display:flex; gap:1rem; justify-content:center;">
            <button id="modalConfirmBtn" class="btn-gold">Yes, Proceed</button>
            <button id="modalCancelBtn" class="btn-outline">Cancel</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentUserId = null;
        let isEditMode = false;

        // --- 1. LOAD PROFILE ---
        async function loadProfile() {
            const token = localStorage.getItem('token');
            if (!token) {
                document.getElementById('profileLoading').innerHTML = `
                    <p>Please <a href="/Account/Login">login</a> to view your profile.</p>
                `;
                document.getElementById('profileContent').style.display = 'none';
                return;
            }

            try {
                const response = await fetch('/Account/GetProfile', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (!response.ok) throw new Error('Failed to load profile');
                const data = await response.json();

                currentUserId = data.userId;
                document.getElementById('profileFullName').value = data.fullName || '';
                document.getElementById('profileEmail').value = data.email || '';
                document.getElementById('profilePhone').value = data.phoneNumber || '';
                document.getElementById('profileAddress').value = data.address || '';
                document.getElementById('profileCreatedAt').textContent = data.createdAt ? new Date(data.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) : 'N/A';

                // Avatar
                const avatarUrl = data.avatarUrl || '';
                const avatarImg = document.getElementById('avatarPreview');
                const placeholder = document.getElementById('avatarPlaceholder');
                if (avatarUrl) {
                    avatarImg.src = avatarUrl;
                    avatarImg.style.display = 'block';
                    placeholder.style.display = 'none';
                } else {
                    avatarImg.style.display = 'none';
                    placeholder.style.display = 'block';
                }

                document.getElementById('profileEmail').style.background = '';
                setReadonly(true);

                document.getElementById('profileLoading').style.display = 'none';
                document.getElementById('profileContent').style.display = 'block';

            } catch (error) {
                console.error('Error loading profile:', error);
                document.getElementById('profileLoading').innerHTML = `
                    <p style="color:#d32f2f;">Failed to load profile. Please try again.</p>
                    <button class="btn-gold" onclick="loadProfile()" style="font-size:0.8rem; margin-top:0.5rem;">RETRY</button>
                `;
            }
        }

        function setReadonly(isReadonly) {
            const inputs = document.querySelectorAll('#profileForm input, #profileForm textarea');
            inputs.forEach(input => {
                if (isReadonly) {
                    input.setAttribute('readonly', 'readonly');
                    input.style.background = '';
                } else {
                    input.removeAttribute('readonly');
                }
            });
        }

        function enableEdit() {
            isEditMode = true;
            setReadonly(false);
            document.getElementById('editActions').style.display = 'block';
            document.getElementById('editProfileBtn').style.display = 'none';
        }

        function cancelEdit() {
            isEditMode = false;
            loadProfile();
            document.getElementById('editActions').style.display = 'none';
            document.getElementById('editProfileBtn').style.display = 'inline-block';
        }

        // --- 2. SAVE PROFILE ---
        document.getElementById('profileForm').addEventListener('submit', function(e) {
            e.preventDefault();
            if (!isEditMode) return;
            showModal('💾', 'Save Changes', 'Are you sure you want to save your profile changes?', performSave);
        });

        async function performSave() {
            const token = localStorage.getItem('token');
            if (!token) { showToast('Please login.', 'error'); return; }

            const payload = {
                fullName: document.getElementById('profileFullName').value.trim(),
                email: document.getElementById('profileEmail').value.trim(),
                phoneNumber: document.getElementById('profilePhone').value.trim(),
                address: document.getElementById('profileAddress').value.trim()
            };

            if (!payload.fullName || !payload.email || !payload.phoneNumber || !payload.address) {
                showToast('All fields are required.', 'error');
                return;
            }
            if (!payload.email.includes('@@')) {
                showToast('Please enter a valid email.', 'error');
                return;
            }
            if (payload.phoneNumber.length < 10) {
                showToast('Please enter a valid phone number.', 'error');
                return;
            }

            try {
                const response = await fetch('/Account/UpdateProfile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(payload)
                });
                const data = await response.json();
                if (response.ok) {
                    showToast(data.message, 'success');
                    localStorage.setItem('userName', data.fullName);
                    document.getElementById('navUserName').textContent = data.fullName;
                    cancelEdit();
                } else {
                    showToast(data.message || 'Failed to update.', 'error');
                }
            } catch (error) {
                showToast('Network error.', 'error');
            }
        }

        // --- 3. AVATAR UPLOAD ---
        async function handleAvatarUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            // Check file size (max 2MB)
            if (file.size > 2 * 1024 * 1024) {
                showToast('Image size must be less than 2MB.', 'error');
                return;
            }

            // Check file type
            const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
            if (!allowedTypes.includes(file.type)) {
                showToast('Only JPG, PNG, and GIF images are allowed.', 'error');
                return;
            }

            const reader = new FileReader();
            reader.onload = async function(e) {
                const base64 = e.target.result;

                // Show preview
                const avatarImg = document.getElementById('avatarPreview');
                const placeholder = document.getElementById('avatarPlaceholder');
                avatarImg.src = base64;
                avatarImg.style.display = 'block';
                placeholder.style.display = 'none';

                // Upload to server
                const token = localStorage.getItem('token');
                try {
                    const response = await fetch('/Account/uploadavatar', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': 'Bearer ' + token
                        },
                        body: JSON.stringify({ avatarBase64: base64 })
                    });
                    const data = await response.json();
                    if (response.ok) {
                        showToast(data.message, 'success');
                    } else {
                        showToast(data.message || 'Failed to upload avatar.', 'error');
                    }
                } catch (error) {
                    showToast('Network error.', 'error');
                }
            };
            reader.readAsDataURL(file);
        }

        // --- 4. CHANGE PASSWORD ---
        function openChangePassword() {
            document.getElementById('changePasswordModal').style.display = 'flex';
            document.getElementById('changePasswordForm').reset();
        }

        function closeChangePassword() {
            document.getElementById('changePasswordModal').style.display = 'none';
        }

        document.getElementById('changePasswordForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const oldPassword = document.getElementById('oldPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmNewPassword').value;

            if (newPassword !== confirmPassword) {
                showToast('New passwords do not match.', 'error');
                return;
            }

            const passRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\da-zA-Z]).{8,}$/;
            if (!passRegex.test(newPassword)) {
                showToast('Password must be 8+ chars with uppercase, lowercase, number, and special character.', 'error');
                return;
            }

            const token = localStorage.getItem('token');
            try {
                console.log('Sending password change payload:', {
                    OldPassword: oldPassword,
                    NewPassword: newPassword,
                    ConfirmPassword: confirmPassword
                });
                const response = await fetch('/Account/ChangePassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({
                        OldPassword: oldPassword,
                        NewPassword: newPassword,
                        ConfirmPassword: confirmPassword
                    })
                });
                const data = await response.json();
                if (response.ok) {
                    showToast(data.message, 'success');
                    closeChangePassword();
                } else {
                    showToast(data.message || 'Failed to change password.', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Network error. Please try again.', 'error');
            }
        });

        // --- 5. ADDRESS BOOK ---
        async function openAddressBook() {
            document.getElementById('addressBookModal').style.display = 'flex';
            await loadAddresses();
            document.getElementById('addAddressForm').reset();
            document.getElementById('addrIsDefault').checked = false;
        }

        function closeAddressBook() {
            document.getElementById('addressBookModal').style.display = 'none';
        }

        async function loadAddresses() {
            const token = localStorage.getItem('token');
            try {
                const response = await fetch('/Account/getaddresses', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (!response.ok) throw new Error('Failed to load addresses');
                const addresses = await response.json();
                renderAddresses(addresses);
            } catch (error) {
                console.error('Error loading addresses:', error);
                document.getElementById('addressList').innerHTML = '<p style="color:red;">Failed to load addresses.</p>';
            }
        }

        function renderAddresses(addresses) {
            const container = document.getElementById('addressList');
            if (!addresses || addresses.length === 0) {
                container.innerHTML = '<p style="color:var(--text-muted); text-align:center; padding:1rem 0;">No addresses saved yet.</p>';
                return;
            }
            let html = '';
            addresses.forEach(addr => {
                html += `
                    <div class="address-card">
                        ${addr.isDefault ? '<span class="default-badge">⭐ DEFAULT</span>' : ''}
                        <div class="address-label">${addr.label}</div>
                        <div class="address-detail">${addr.addressLine1}</div>
                        ${addr.addressLine2 ? `<div class="address-detail">${addr.addressLine2}</div>` : ''}
                        <div class="address-detail">${addr.city}, ${addr.state} - ${addr.pincode}</div>
                        <div class="address-detail">📞 ${addr.phoneNumber}</div>
                        <button class="btn-outline" onclick="deleteAddress(${addr.addressId})" style="font-size:0.7rem; padding:0.2rem 0.8rem; margin-top:0.3rem;">🗑️ Remove</button>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        document.getElementById('addAddressForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const token = localStorage.getItem('token');

            const payload = {
                label: document.getElementById('addrLabel').value,
                addressLine1: document.getElementById('addrLine1').value.trim(),
                addressLine2: document.getElementById('addrLine2').value.trim(),
                city: document.getElementById('addrCity').value.trim(),
                state: document.getElementById('addrState').value.trim(),
                pincode: document.getElementById('addrPincode').value.trim(),
                phoneNumber: document.getElementById('addrPhone').value.trim(),
                isDefault: document.getElementById('addrIsDefault').checked
            };

            if (!payload.addressLine1 || !payload.city || !payload.state || !payload.pincode || !payload.phoneNumber) {
                showToast('Please fill in all required fields.', 'error');
                return;
            }
            if (payload.pincode.length !== 6) {
                showToast('Please enter a valid 6-digit pincode.', 'error');
                return;
            }
            if (payload.phoneNumber.length < 10) {
                showToast('Please enter a valid phone number.', 'error');
                return;
            }

            try {
                const response = await fetch('/Account/addaddress', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(payload)
                });
                const data = await response.json();
                if (response.ok) {
                    showToast(data.message, 'success');
                    await loadAddresses();
                    document.getElementById('addAddressForm').reset();
                    document.getElementById('addrIsDefault').checked = false;
                } else {
                    showToast(data.message || 'Failed to add address.', 'error');
                }
            } catch (error) {
                showToast('Network error.', 'error');
            }
        });

        async function deleteAddress(addressId) {
            showModal('🗑️', 'Delete Address', 'Are you sure you want to remove this address?', async function() {
                const token = localStorage.getItem('token');
                try {
                    const response = await fetch(`/Account/deleteaddress/${addressId}`, {
                        method: 'DELETE',
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                    const data = await response.json();
                    if (response.ok) {
                        showToast(data.message, 'success');
                        await loadAddresses();
                    } else {
                        showToast(data.message || 'Failed to delete address.', 'error');
                    }
                } catch (error) {
                    showToast('Network error.', 'error');
                }
            });
        }

        // --- 6. DELETE ACCOUNT ---
        function confirmDeleteAccount() {
            showModal('⚠️', 'Delete Account', 'Are you sure you want to delete your account? <br><br> <strong>This action cannot be undone.</strong>', async function() {
                const token = localStorage.getItem('token');
                try {
                    const response = await fetch('/Account/DeleteAccount', {
                        method: 'DELETE',
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                    const data = await response.json();
                    if (response.ok) {
                        showToast(data.message, 'success');
                        localStorage.removeItem('token');
                        localStorage.removeItem('userName');
                        localStorage.removeItem('userId');
                        setTimeout(() => window.location.href = '/', 1500);
                    } else {
                        showToast(data.message || 'Failed to delete account.', 'error');
                    }
                } catch (error) {
                    showToast('Network error.', 'error');
                }
            });
        }

        // --- 7. MODAL ---
        function showModal(icon, title, message, onConfirm) {
            document.getElementById('modalIcon').textContent = icon;
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalMessage').innerHTML = message;

            const modal = document.getElementById('confirmModal');
            modal.style.display = 'flex';

            document.getElementById('modalConfirmBtn').onclick = function() {
                modal.style.display = 'none';
                if (onConfirm) onConfirm();
            };
            document.getElementById('modalCancelBtn').onclick = function() {
                modal.style.display = 'none';
            };
            modal.onclick = function(e) {
                if (e.target === modal) modal.style.display = 'none';
            };
        }

        // --- 8. INIT ---
        document.addEventListener('DOMContentLoaded', loadProfile);

        // Close modals on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.getElementById('changePasswordModal').style.display = 'none';
                document.getElementById('addressBookModal').style.display = 'none';
                document.getElementById('confirmModal').style.display = 'none';
            }
        });
    </script>
}